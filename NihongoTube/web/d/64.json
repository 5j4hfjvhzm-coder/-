{"加減":[["かげん","가감 (加減)","더하거나 뺌."],["かげん","더덜이"]],"加減乗除":[["かげんじょうじょ","가감승제 (加減乘除)","더하기, 빼기, 곱하기, 나누기의 계산."]],"加減する":[["かげんする","가감하다 (加減하다)","더하거나 빼다."]],"加工":[["かこう","가공 (加工)","기술이나 힘 등을 이용해 원료나 재료를 새로운 제품으로 만듦."]],"加工される":[["かこうされる","가공되다 (加工되다)","기술이나 힘 등에 의해 원료나 재료가 새로운 제품으로 만들어지다."]],"加工法":[["かこうほう","가공법 (加工法)","식품이나 물품 등을 가공하는 방법."]],"加工性":[["かこうせい","가공성 (加工性)","기술이나 힘 등에 의해 원료나 재료가 새로운 제품으로 만들어질 수 있는 성질."]],"加工食品":[["かこうしょくひん","가공식품 (加工食品)","저장과 조리가 편리하도록 원료를 특별한 방법으로 가공하여 새롭게 만든 먹을거리."],["かこうしょくひん","가공 식품 (加工食品)"]],"加工業":[["かこうぎょう","가공업 (加工業)","기술이나 힘 등을 이용해 원료나 재료를 새로운 제품으로 만드는 공업."]],"加工品":[["かこうひん","가공품 (加工品)","원료나 재료를 가공하여 새롭게 만들어 낸 제품."]],"加工製品":[["かこうせいひん","가공품 (加工品)","원료나 재료를 가공하여 새롭게 만들어 낸 제품."]],"加工する":[["かこうする","가공하다 (加工하다)","기술이나 힘 등을 이용해 원료나 재료를 새로운 제품으로 만들다."]],"加担":[["かたん","가담 (加擔)","한편이 되어 일을 하거나 도움."]],"加担する":[["かたんする","가담하다 (加擔하다)","한편이 되어 일을 하거나 돕다."],["かたんする","한다리 걸치다  《관용구》"]],"掠め取る":[["かすめとる","갉아먹다","남의 것을 나쁜 방법으로 빼앗아 가지다."],["かすめとる","집어먹다","남의 것을 빼앗아 자기 것으로 만들다."],["かすめとる","집어삼키다","남의 것을 빼앗아 자기 것으로 만들다."],["かすめとる","갉다","남의 재물을 나쁜 방법으로 빼앗다."]],"ムーダン":[["","무당","귀신을 받들어 점치고 굿을 하는 것을 직업으로 하는 사람."],["","강신무 (降神巫)","신이 내려서 된 무당."]],"毀謗":[["きぼう","훼방 (毁謗)","남을 해치려고 나쁘게 말함."]],"毀謗する":[["きぼうする","훼방하다 (毁謗하다)","남을 해치려고 나쁘게 말하다."]],"毀損":[["きそん","훼손 (毁損)","가치나 이름, 체면 등을 상하게 함."]],"毀損される":[["きそんされる","훼손되다 (毁損되다)","가치나 이름, 체면 등이 상하게 되다."]],"毀損する":[["きそんする","훼손하다 (毁損하다)","가치나 이름, 체면 등을 상하게 하다."]],"最悪だ":[["さいあくだ","흉악하다 (凶惡/兇惡하다)","일 등이 아주 마음에 들지 않거나 나쁘다."]],"最悪":[["さいあく","최악 (最惡)","여럿 가운데서 가장 나쁨."],["さいあく","흉악하다 (凶惡/兇惡하다)","일 등이 아주 마음에 들지 않거나 나쁘다."]],"犠牲":[["ぎせい","희생 (犧牲)","어떤 사람이나 목적을 위해 자신의 목숨, 재산, 명예, 이익 등을 바치거나 버림. 또는 그것을 빼앗김."],["いけにえ","제물 (祭物)","제사를 지낼 때 바치는 물건이나 동물."],["ぎせい","밥","(비유적으로) 다른 사람에게 이용당하거나 희생되는 사람."]],"犠牲になる":[["ぎせいになる","희생되다 (犧牲되다)","어떤 사람이나 목적 때문에 목숨, 재산, 명예, 이익 등이 바쳐지거나 버려지다. 또는 그것이 빼앗기게 되다."]],"犠牲にさせる":[["ぎせいにさせる","희생시키다 (犧牲시키다)","어떤 사람이나 목적을 위해 목숨, 재산, 명예, 이익 등을 바치거나 버리게 하다."]],"犠牲者":[["ぎせいしゃ","희생자 (犧牲者)","희생을 당한 사람."]],"犠牲的":[["ぎせいてき","희생적 (犧牲的)","어떤 사람이나 목적을 위해 자신의 목숨, 재산, 명예, 이익 등을 바치거나 버리는 것."]],"犠牲的精神":[["ぎせいてきせいしん","희생정신 (犧牲精神)","어떤 사람이나 목적을 위해 자신의 목숨, 재산, 명예, 이익 등을 바치거나 버리는 정신."]],"犠牲にする":[["ぎせいにする","희생하다 (犧牲하다)","어떤 사람이나 목적을 위해 자신의 목숨, 재산, 명예, 이익 등을 바치거나 버리다. 또는 그것을 빼앗기다."]],"ムール貝":[["ムールがい","홍합 (紅蛤)","껍질의 겉은 검고 안쪽은 진주색이며 살은 붉은빛을 띠는 조개."]],"ムールがい":[["","홍합 (紅蛤)","껍질의 겉은 검고 안쪽은 진주색이며 살은 붉은빛을 띠는 조개."]],"加盟国":[["かめいこく","회원국 (會員國)","국제기구나 국제적인 조직의 회원인 나라."],["かめいこく","가맹국 (加盟國)","동맹이나 연맹에 가입한 나라."]],"言い換える":[["いいかえる","두말하다","처음에 했던 말과는 다른 내용의 말을 하다."],["いいかえる","환언하다 (換言하다)","앞에서 나온 말을 다르게 바꿔 말하다."]],"言い表す":[["いいあらわす","형언하다 (形言하다)","사람이나 사물의 모양, 상태 또는 사람의 감정 등을 말로 표현하다."]],"言い値":[["いいね","호가 (呼價)","물건의 가격이 정해져 있지 않은 경우에 팔거나 사려는 값을 부름."]],"加える":[["くわえる","가하다 (加하다)","어떤 행위나 작용을 통해 영향을 주다."],["くわえる","더하다","보태어 늘리거나 많게 하다."],["くわえる","타다","많은 양의 액체에 적은 양의 액체나 가루를 넣어 섞다."],["くわえる","플러스하다 (plus하다)","덧셈을 하다."],["くわえる","합하다 (合하다)","둘 이상의 수나 식을 더하다."],["くわえる","끼우다","어떤 것에 함께 포함시키다."],["くわえる","붙이다","어떤 일을 하는 데 끼게 하거나 단체에 속하게 하다."],["くわえる","화하다 (和─)"]],"加算":[["かさん","가산 (加算)","더하여 셈함."],["かさん","합산 (合算)","둘 이상을 더하여 계산함."],["かさん","플러스 (plus)","덧셈을 함."]],"加算される":[["かさんされる","가산되다 (加算되다)","돈이나 점수 등이 더해지다."],["かさんされる","합산되다 (合算되다)","둘 이상이 더하여져 계산되다."]],"加算する":[["かさんする","가산하다 (加算하다)","돈이나 점수 등을 더하다."],["かさんする","합산하다 (合算하다)","둘 이상을 더하여 계산하다."]],"加勢":[["かせい","합세 (合勢)","흩어져 있는 힘을 한곳에 모음."],["かせい","가세 (加勢)","함께하여 힘을 보탬."],["かせい","조력 (助力)"]],"加勢する":[["かせいする","가세하다 (加勢하다)","함께하여 힘을 보태다."],["かせいする","합세하다 (合勢하다)","흩어져 있는 힘을 한곳에 모으다."]],"最中":[["さいちゅう","통","어떤 일이 벌어진 상황이나 형편."],["さいちゅう","한창","어떤 일이 가장 활기 있고 왕성하게 일어나는 때. 또는 어떤 상태가 가장 무르익은 때."],["さいちゅう","가운데","어떤 행동이나 상태가 계속되는 동안."]],"最中に":[["さいちゅうに","한창","어떤 일이 가장 활기 있고 왕성하게 일어나는 모양. 또는 어떤 상태가 가장 무르익은 모양."]],"最盛期":[["さいせいき","한철","한창 성한 때."],["さいせいき","봄","(비유적으로) 인생에서 가장 좋은 시기."],["さいせいき","극성기 (極盛期)"],["さいせいき","최성기 (最盛期)"]],"加算金":[["かさんきん","할증료 (割增料)","정해진 가격에 더하여 내는 돈."],["かさんきん","가산금 (加算金)"]],"加号":[["かごう","플러스 (plus)","덧셈을 표시하는 부호."]],"言訳":[["いいわけ","핑계","잘못에 대한 비난을 피하려고 이리저리 돌려 말하는 변명."]],"言う":[["いう","이르다","어떤 것을 말하다."],["いう","말하다","어떤 사실이나 자신의 생각 또는 느낌을 말로 나타내다."],["いう","운위하다 (云謂하다)","어떤 대상에 대하여 무엇이라고 말하다."],["いう","이야기하다","어떠한 사실이나 상태, 현상, 경험, 생각 등에 관해 누군가에게 말을 하다."],["いう","일컫다","이름을 지어 부르다."],["いう","부르다","남이 받아 적거나 되풀이할 수 있게 말하다."],["いう","하다","이름을 지어서 부르다."],["いう","치다","어떠한 것으로 기준을 삼아 생각하다."],["いう","보다","남의 결점 등을 들추어 말하다."],["いう","얘기하다","어떠한 것에 대한 소문을 내거나 평을 하다."],["いう","칭하다 (稱―)"],["いう","운위하다 (云謂─)"]],"言い張る":[["いいはる","우기다","억지를 부려 자기의 의견이나 뜻을 고집스럽게 내세우다."],["いいはる","펴다","생각이나 의견, 감정 등을 자유롭게 표현하거나 주장하다."],["いいはる","떠들다","의견이나 입장을 계속 주장하다."],["いいはる","우겨대다"]],"言い争う":[["いいあらそう","언쟁하다 (言爭하다)","자기가 옳다고 말로 다투다."],["いいあらそう","설왕설래하다 (說往說來하다)","서로 말을 주고받으며 누가 옳고 그른지 따지다."],["いいあらそう","말다툼하다","옳고 그름을 가리기 위해 말로 다투다."],["いいあらそう","말싸움하다","옳고 그름을 가리기 위해 말로 싸우다."],["いいあらそう","티격태격하다","서로 뜻이 맞지 않아 옳고 그름을 따지며 가리다."],["いいあらそう","뒵들다"]],"言い散らす":[["いいちらす","퍼내다","(비유적으로) 말을 자꾸 늘어놓거나 마구 하다."]],"言い掛かり":[["いいがかり","트집","아무 이유 없이 작은 흠을 들추어내어 불평을 하거나 말썽을 부림. 또는 그 불평이나 말썽."],["いいがかり","생트집 (生트집)","별로 문제가 되지 않는 것을 드러내서 이유 없이 불평을 하거나 말썽을 부림. 또는 그 불평이나 말썽."],["いいがかり","구실 (口實)","불리한 사실을 감추거나 옳은 것처럼 보이기 위해 내세우는 이유."]],"言い掛り":[["いいがかり","트집","아무 이유 없이 작은 흠을 들추어내어 불평을 하거나 말썽을 부림. 또는 그 불평이나 말썽."]],"怠業":[["たいぎょう","태업 (怠業)","일이나 공부를 게을리함."],["たいぎょう","태업하다 (怠業하다)","노동 분쟁 과정에서 일부러 일을 게을리하여 사용자에게 손해를 주다."]],"怠業する":[["たいぎょうする","태업하다 (怠業하다)","일이나 공부를 게을리하다."]],"言いがかり":[["いいがかり","탈 (頉)","핑계나 트집."],["いいがかり","태클 (tackle)","(속된 말로) 시비를 걺."],["いいがかり","생트집 (生―)"]],"言い聞かせる":[["いいきかせる","일러두다","특별히 부탁하거나 잘 타일러서 시키다."],["いいきかせる","타이르다","잘 알아듣도록 자상하고 조리 있게 말해 주다."],["いいきかせる","이르다","잘 알아듣도록 말해 주다."],["いいきかせる","일깨우다"],["いいきかせる","당조짐하다"]],"最もだ":[["もっともだ","타당하다 (妥當하다)","사물의 이치에 맞아 올바르다."]],"最も":[["もっとも","가장","여럿 가운데에서 제일로."],["もっとも","제일 (第一)","여럿 중에서 가장."],["もっとも","젤","여럿 중에서 가장."],["もっとも","타당하다 (妥當하다)","사물의 이치에 맞아 올바르다."],["もっとも","맨"]],"怠慢":[["たいまん","태만 (怠慢)","열심히 하지 않고 게으름."],["たいまん","태만하다 (怠慢하다)","열심히 하지 않고 게으르다."],["たいまん","과태 (過怠)"],["たいまん","타태 (惰怠)"],["たいまん","해태 (懈怠)"],["たいまん","개으름"],