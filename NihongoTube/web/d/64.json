조상의 이름을 적은 나무패를 모셔 두는 집."]],"加わる":[["くわわる","동참하다 (同參하다)","어떤 일이나 모임에 같이 참가하다."],["くわわる","끼다","여럿 사이에 섞이다."],["くわわる","끼이다","여럿 사이에 섞이다."],["くわわる","붙다","어떤 놀이나 일, 단체 등에 참여하다."],["くわわる","들다","어떤 단체에 가입하다."]],"加えて多くすること":[["","보탬","2."]],"言い訳する":[["いいわけする","변명하다 (辨明하다)","이해나 용서를 구하기 위해 자신의 잘못이나 실수에 대해 그 이유를 밝혀 말하다."]],"言い逃れ":[["いいのがれ","발뺌","자기와 관계된 일에 책임을 지지 않으려고 핑계를 대며 빠짐. 또는 그렇게 하기 위해 하는 말."],["いいのがれ","구실 (口實)"],["いいのがれ","핑계"]],"言い抜け":[["いいぬけ","발뺌","자기와 관계된 일에 책임을 지지 않으려고 핑계를 대며 빠짐. 또는 그렇게 하기 위해 하는 말."]],"言い逃れる":[["いいのがれる","발뺌하다","자기와 관계된 일에 책임을 지지 않으려고 핑계를 대며 빠지다."]],"言い抜ける":[["いいぬける","발뺌하다","자기와 관계된 일에 책임을 지지 않으려고 핑계를 대며 빠지다."]],"言い渡される":[["いいわたされる","받다","어떠한 결정이나 판결을 당하다."]],"言い返す":[["いいかえす","뒤받다","다른 사람의 충고나 꾸중에 말대답을 하며 대들다."],["いいかえす","되뇌다","같은 말을 계속 반복하다."],["いいかえす","말대꾸하다","상대방의 말을 듣고 그대로 받아들이지 않고 바로 자신의 의견이나 생각을 말하다."],["いいかえす","되받아치다","상대편의 말에 대해 반대하는 말을 하다."],["いいかえす","맞받아치다","남의 말이나 행동에 곧바로 대응하여 나서다."],["いいかえす","받아치다","다른 사람의 비판이나 농담 등의 말을 맞받아 대꾸하다."],["いいかえす","되씹다","같은 말을 계속 되풀이해서 말하다."],["いいかえす","맞받다","남의 말이나 행동 등에 정면으로 대응하다."],["いいかえす","되받다","다른 사람의 충고나 꾸중에 말대답을 하며 대들다."],["いいかえす","되쏘다","상대편의 말에 반대하는 뜻을 나타내기 위해 공격하듯 말하다."],["いいかえす","대받다"],["いいかえす","되채다"]],"ムジゲトク":[["","무지개떡","무지개처럼 층층이 여러 가지 색깔을 넣어서 만든 떡."]],"ムンプンジ":[["","문풍지 (門風紙)","문틈 사이로 들어오는 바람을 막기 위해 문짝 가장자리를 빙 둘러 붙여 놓은 종이."]],"ムルキムチ":[["","물김치","국물의 양을 많게 하여 담근 김치."]],"最悪の":[["さいあくの","몹쓸","몹시 나쁘고 못된."]],"最低の":[["さいていの","몹쓸","몹시 나쁘고 못된."]],"ムク":[["","묵","도토리, 메밀, 녹두 등을 가루로 만들어 되게 쑤어서 굳힌 음식."]],"ムクの器":[["ムクのうつわ","묵사발 (묵沙鉢)","묵을 담은 그릇."]],"ムクのうつわ":[["","묵사발 (묵沙鉢)","묵을 담은 그릇."]],"ムキムチ":[["","무김치","무로 담근 김치."]],"ムース":[["","무스 (mousse)","크림이나 젤리에 거품을 일으켜 설탕과 향료를 넣은 뒤 차게 해서 먹는 디저트."]],"言い付け":[["いいつけ","명 (命)","윗사람이 아랫사람에게 무엇을 시킴. 또는 그런 내용."],["いいつけ","명령 (命令)"],["いいつけ","분부 (分付·吩咐)"]],"最高の":[["さいこうの","맨","더 할 수 없을 정도로 제일."]],"言葉の意味":[["ことばのいみ","말귀","말이 뜻하는 내용."],["ことばのいみ","말귀 (←―句)"]],"言葉尻":[["ことばじり","말끝","짧은 말 또는 이야기의 맨 끝."],["ことばじり","말꼬리","짧은 말 또는 이야기의 맨 끝."]],"言葉遊び":[["ことばあそび","말놀이","끝말잇기와 같이 말을 주고받으며 노는 놀이."]],"言い返し":[["いいかえし","말대꾸","상대방의 말을 듣고 그대로 받아들이지 않고 바로 자신의 의견이나 생각을 말함. 또는 그 말."],["いいかえし","응수 (應酬)"],["いいかえし","말대꾸 (―對―)"],["いいかえし","맞대꾸"]],"言いがい":[["いいがい","말발","듣는 사람을 그 말대로 따르게 하는 말의 힘."]],"言い誤り":[["いいあやまり","말실수 (말失手)","말을 조심하지 않아서 저지르는 실수. 또는 그 말."]],"言葉":[["ことば","말","생각이나 느낌을 표현하고 전달하는 사람의 소리."],["ことば","말씀","(낮추는 말로) 자기의 말."]],"言葉遣い":[["ことばづかい","말씨","말하는 태도나 버릇."]],"言葉を慎む":[["ことばをつつしむ","말조심하다 (말操心하다)","말이 잘못되지 않게 조심하다."]],"言い回し":[["いいまわし","말주변","막히지 않고 말을 잘 하거나 이리저리 잘 둘러대는 재주."]],"ムハンマド":[["","마호메트 (Mahomet)","이슬람교의 창시자(?570~632). 히라산에서 알라 신의 계시를 받아 알라에 대한 숭배를 가르치기 시작했으며 아라비아 전역에 정치적, 역사적으로 큰 영향을 끼쳤다."]],"漠漠だ":[["ばくばくだ","막막하다 (寞寞하다)","주위가 쓸쓸하고 고요하다."],["ばくばくだ","막막하다 (漠漠하다)","끝이 없을 정도로 넓고 아득하다."]],"漠漠":[["ばくばく","막막하다 (寞寞하다)","주위가 쓸쓸하고 고요하다."],["ばくばく","막막하다 (漠漠하다)","끝이 없을 정도로 넓고 아득하다."]],"漠然だ":[["ばくぜんだ","막막하다 (漠漠하다)","아득하고 막연하다."]],"漠然":[["ばくぜん","막막하다 (漠漠하다)","아득하고 막연하다."],["ばくぜん","막연 (漠然)"]],"漠然と":[["ばくぜんと","막연히 (漠然히)","뚜렷하지 않고 어렴풋하게."]],"言い分":[["いいぶん","말","논리적이거나 이치에 맞는 이야기."],["いいぶん","할말"]],"言い出す":[["いいだす","떼다","말을 시작하다."]],"言い始める":[["いいはじめる","떼다","말을 시작하다."]],"言い触らす":[["いいふらす","떠들다","어떤 일을 여기저기 말하여 널리 퍼뜨리다."]],"言い広める":[["いいひろめる","떠들다","어떤 일을 여기저기 말하여 널리 퍼뜨리다."]],"言うまでもない":[["いうまでもない","두말없다","더 말할 필요도 없이 확실하다."],["いうまでもない","다이를까"],["いうまでもない","말할 것도 없다  《관용구》"],["いうまでもない","두말할 나위도 없다  《관용구》"]],"言うまでもなく":[["いうまでもなく","두말없이","더 말할 필요도 없이 확실하게."],["いうまでもなく","아무려면"],["いうまでもなく","말할 것도 없이  《관용구》"]],"言い繕う":[["いいつくろう","둘러대다","그럴듯한 말로 꾸며 속이다."],["いいつくろう","둘러맞추다"]],"加入する":[["かにゅうする","가입되다 (加入되다)","단체에 들어가게 되거나 상품 및 서비스를 받기 위해 계약을 하게 되다."],["かにゅうする","가입하다 (加入하다)","단체에 들어가거나 상품 및 서비스를 받기 위해 계약을 하다."],["かにゅうする","들다","적금, 보험 등에 가입하다."]],"加法":[["かほう","덧셈","수나 식을 더하여 계산함. 또는 그런 셈."],["かほう","가법 (加法)"],["かほう","덧셈법 (―法)"],["かほう","보태기"]],"最高裁判所判事":[["さいこうさいばんしょはんじ","대법관 (大法官)","아래 법원에서 올라온 재판에 대하여 마지막으로 판결을 내리는 최고 법원의 판사."],["さいこうさいばんしょはんじ","대법원 판사 (大法院判事)"]],"最高裁判所":[["さいこうさいばんしょ","대법원 (大法院)","아래 법원에서 올라온 재판에 대하여 마지막으로 판결을 내리는 최고 법원."]],"最高裁判所長官":[["さいこうさいばんしょちょうかん","대법원장 (大法院長)","대법원에서 가장 높은 직위. 또는 그 직위에 있는 사람."]],"最高検察庁":[["さいこうけんさつちょう","대검 (大檢)","대법원에 대응하여 설치된 검찰의 최고 기관."],["さいこうけんさつちょう","대검찰청 (大檢察廳)","대법원에 대응하여 설치된 검찰의 최고 기관."]],"怠け者":[["なまけもの","느림보","(낮잡아 이르는 말로) 게으르거나 움직임이 느린 사람 또는 동물."],["なまけもの","농땡이","(속된 말로) 꾀를 부리며 게으름을 피우는 행동. 또는 그런 사람."],["なまけもの","느림뱅이","(낮잡아 이르는 말로) 행동이 느리거나 게으른 사람."],["なまけもの","게으름뱅이","(낮잡아 이르는 말로) 게으른 사람."],["なまけもの","늘보"],["なまけもの","느리광이"],["なまけもの","개으름쟁이"],["なまけもの","게으름쟁이"]],"檀君":[["タングン","단군 (檀君)","고조선을 세운 왕이자 우리 민족의 시조. 신화에 따르면 하늘에서 내려온 환웅과 곰이 사람으로 변한 웅녀 사이에서 태어났다고 한다."]],"檀君紀元":[["タングンきげん","단기 (檀紀)","단군이 즉위한 해인 기원전 2333년을 원년으로 삼는 한국의 기원."],["タングンきげん","단군 기원 (檀君紀元)"]],"檀紀":[["タンギ","단기 (檀紀)","단군이 즉위한 해인 기원전 2333년을 원년으로 삼는 한국의 기원."]],"詠う":[["うたう","노래하다","시와 같이 운율이 있는 언어로 생각이나 감정을 표현하다."]],"言葉などを不作法に吐く":[["","내갈기다",""]],"怠惰心":[["たいだしん","나태심 (懶怠心)","행동이나 성격이 느리고 게으른 마음."]],"章魚":[["たこ","낙지","문어와 생김새가 비슷하며 뼈가 없는 회색 몸에 빨판이 달린 여덟 개의 긴 다리가 있고 위험할 때 먹물을 뿜는 바다 동물."]],"紀元":[["きげん","기원 (紀元)","역사에서 연대를 세는 시작점이 되는 해."]],"紀元前":[["きげんぜん","기원전 (紀元前)","예수가 태어난 해를 기준으로 한 달력에서 기준 연도의 이전."],["きげんぜん","비시 (B.C.)"]],"紀元後":[["きげんご","기원후 (紀元後)","예수가 태어난 해를 기준으로 한 달력에서 기준 연도의 이후."]],"攀じ登る":[["よじのぼる","기어오르다","몸을 구부려 기는 듯한 모습으로 가파르거나 높은 곳을 올라가다."]],"攀じ上る":[["よじのぼる","기어오르다","몸을 구부려 기는 듯한 모습으로 가파르거나 높은 곳을 올라가다."]],"紀行":[["きこう","기행 (紀行)","여행하며 보고 듣고 느끼고 경험한 것을 적음. 또는 그 글."],["きこう","기행문 (紀行文)","여행하며 보고 듣고 느끼고 경험한 것을 적은 글."]],"紀行文":[["きこうぶん","기행문 (紀行文)","여행하며 보고 듣고 느끼고 경험한 것을 적은 글."],["きこうぶん","기행 (紀行)","여행하며 보고 듣고 느끼고 경험한 것을 적음. 또는 그 글."]],"紀綱":[["きこう","기강 (紀綱)","어떤 집단이나 사회의 규율과 질서."]],"最優秀賞":[["さいゆうしゅうしょう","그랑프리 (grand prix)","가요제나 영화제 등과 같은 대회에서 가장 뛰어난 사람에게 주는 상."]],"言いくるめる":[["いいくるめる","구슬리다","그럴듯한 말로 꾀거나 달래어 마음을 움직이다."],["いいくるめる","구워삶다","여러 가지 수단과 방법으로 상대방을 자기의 뜻대로 움직이도록 만들다."]],"言言":[["げんげん","구구절절 (句句節節)","말 한마디 한마디."]],"膠着":[["こうちゃく","교착 (膠着)","어떤 상태가 굳어져 달라지거나 나아지지 않고 그대로 있음."]],"膠着する":[["こうちゃくする","교착되다 (膠着되다)","어떤 상태가 굳어져 달라지거나 나아지지 않고 그대로 있다."],["こうちゃくする","교착하다 (膠着하다)","어떤 상태가 굳어져 달라지거나 나아지지 않고 그대로 있다."]],"峠道":[["とうげみち","고갯길","고개를 오르