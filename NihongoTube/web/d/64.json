."],["ほえる","으르렁하다","크고 사나운 동물이 공격적으로 크고 세차게 울부짖다."],["ほえる","으르렁거리다","크고 사나운 동물이 계속 공격적으로 크고 세차게 울부짖다."],["ほえる","으르렁으르렁하다","크고 사나운 동물이 계속 공격적으로 크고 세차게 울부짖다."],["ほえる","우짖다","소리를 높여 크게 울다."],["ほえる","울다","짐승, 벌레, 바람 등이 소리를 내다."]],"怠い":[["だるい","찌뿌드드하다","몸살이나 감기로 몸이 무거워서 움직임이 자연스럽지 못하다."]],"峠":[["とうげ","재","넘어 다닐 수 있게 길이 나 있는, 높은 산의 고개."],["とうげ","고비","일이 되어 가는 과정에서 가장 중요하거나 힘든 순간."],["とうげ","고개","산이나 언덕을 오르내리며 다닐 수 있게 길이 나 있는 곳."],["とうげ","고개턱","산이나 언덕 꼭대기의 솟아오른 부분."],["とうげ","절정기","사물의 진행이나 발전이 최고에 이른 시기."],["とうげ","준령 (峻嶺)","(비유적으로) 힘들고 어려운 고비."],["とうげ","한고비"]],"祀る":[["まつる","제사하다 (祭祀하다)","신이나 죽은 사람의 영혼에게 음식을 바쳐 정성을 나타내다."]],"毀れる":[["こわれる","조각나다","(비유적으로) 마음, 믿음, 관계 등이 깨지거나 갈라지다."]],"言い成りになる":[["いいなりになる","종노릇하다","종처럼 행동하거나 그런 태도를 가지다."]],"言成りになる":[["いいなりになる","종노릇하다","종처럼 행동하거나 그런 태도를 가지다."]],"章":[["しょう","장 (章)","글의 내용을 체계적으로 나누는 구분의 하나."]],"言い切る":[["いいきる","장담하다 (壯談하다)","확신하여 아주 자신 있게 말하다."],["いいきる","단언하다 (斷言하다)","확실하다고 믿고 망설임 없이 자신 있게 말하다."]],"言切る":[["いいきる","장담하다 (壯談하다)","확신하여 아주 자신 있게 말하다."]],"言下":[["ごんか","일언지하 (一言之下)","한 마디로 잘라 말함."]],"言聞かせる":[["いいきかせる","일러두다","특별히 부탁하거나 잘 타일러서 시키다."]],"言い付ける":[["いいつける","일러바치다","남의 잘못이나 실수 등을 윗사람에게 알리다."],["いいつける","명하다 (命하다)","윗사람이 아랫사람에게 무엇을 하게 하다."],["いいつける","이르다","남의 잘못이나 실수를 다른 사람에게 말하다."]],"言付ける":[["いいつける","일러바치다","남의 잘못이나 실수 등을 윗사람에게 알리다."]],"言い争うこと":[["","입씨름",""],["","구론 (口論)"],["","설론 (舌論)"],["","설전 (舌戰)"],["","말다툼"]],"言わば":[["いわば","일테면","다른 말로 하자면."],["いわば","이를테면","다른 말로 하자면."],["いわば","말하자면"]],"加熱する":[["かねつする","익히다","고기, 채소, 곡식 등의 날것을 열을 가해 맛과 성질이 달라지게 하다."],["かねつする","가열되다 (加熱되다)","어떤 일이나 사건에 대한 관심이 높아지고 분위기가 흥분되다."],["かねつする","가열하다 (加熱하다)","어떤 일이나 사건에 대한 관심을 높이고 분위기를 흥분시키다."]],"最早":[["もはや","이제","지금의 시기가 되어."]],"儀式":[["ぎしき","의식 (儀式)","정해진 방법이나 절차에 따라 치르는 행사."],["ぎしき","예식 (禮式)","예의와 규범에 따라 행하는 의식."],["ぎしき","식 (式)","정해진 방식에 따라 치르는 행사."]],"儀仗隊":[["ぎじょうたい","의장대 (儀仗隊)","국가의 큰 행사에서 의식을 진행하기 위해 특별히 조직되고 훈련된 부대."]],"糠雨":[["ぬかあめ","이슬비","아주 가늘게 내리는 비."],["ぬかあめ","안개비","매우 가늘게 날려서 떨어지는 비."],["ぬかあめ","세우 (細雨)"]],"言われる":[["いわれる","이야기되다","어떠한 사실이나 상태, 현상, 경험, 생각 등에 관해 누군가에게 하는 말이나 글이 되다."],["いわれる","얻어먹다","남에게 나쁜 말을 듣다."]],"言い訳":[["いいわけ","변명 (辨明)","이해나 용서를 구하기 위해 자신의 잘못이나 실수에 대해 그 이유를 밝혀 말함."],["いいわけ","구실 (口實)","불리한 사실을 감추거나 옳은 것처럼 보이기 위해 내세우는 이유."],["いいわけ","이유 (理由)","벌어진 일을 책임지지 않기 위해 하는 핑계나 변명."],["いいわけ","변명 (辯明)"],["いいわけ","핑계"]],"最重要":[["さいじゅうよう","으뜸","어떤 일에서 가장 중요하거나 기본이 되는 것."]],"最上だ":[["さいじょうだ","으뜸가다","많은 것 가운데 가장 뛰어나거나 순서에서 첫째가 되다."],["さいじょうだ","위없다"]],"儀礼":[["ぎれい","의례 (儀禮)","행사를 치르는 일정한 형식과 절차. 또는 정해진 형식과 절차에 따라 치르는 행사."]],"儀礼的":[["ぎれいてき","의례적 (儀禮的)","행사를 치르는 일정한 형식과 절차에 맞는 것."]],"儀礼的に":[["ぎれいてきに","의례히 (依例히)","이전부터 해 오던 대로."]],"銀":[["ぎん","은 (銀)","귀금속이나 그릇 등을 만드는 데 쓰는, 흰 광택이 나고 무른 성질이 있는 금속."]],"銀器":[["ぎんき","은그릇 (銀그릇)","은으로 만든 그릇."],["ぎんき","은기 (銀器)"]],"詠む":[["よむ","읊다","시나 노래 등을 억양을 넣어 읽거나 외다."]],"銀幕":[["ぎんまく","은막 (銀幕)","영화 등을 비추어서 볼 수 있는 흰색의 막."]],"銀メダル":[["ぎんメダル","은메달 (銀medal)","경기나 대회에서 2위를 차지한 선수에게 주는, 은으로 만든 메달."]],"銀箔":[["ぎんぱく","은박 (銀箔)","은 또는 은과 같은 빛깔의 재료를 종이와 같이 얇게 만든 것."],["ぎんぱく","은박지 (銀箔紙)"]],"銀盤":[["ぎんばん","은반 (銀盤)","은으로 만든 쟁반."]],"銀髪":[["ぎんぱつ","은발 (銀髮)","은백색의 머리털."]],"銀鈴":[["ぎんれい","은방울 (銀방울)","은으로 만든 방울."],["ぎんれい","은방울 (銀―)"]],"銀白色":[["ぎんはくいろ","은백색 (銀白色)","은과 같이 흰 색."]],"銀色":[["ぎんいろ","은빛 (銀빛)","반짝이는 은과 같은 빛깔."],["ぎんいろ","은색 (銀色)","반짝이는 은의 빛깔과 같은 색."],["ぎんいろ","은빛 (銀―)"]],"銀賞":[["ぎんしょう","은상 (銀賞)","상의 등급을 금, 은, 동으로 나누었을 때 이 등에 해당하는 상."]],"銀世界":[["ぎんせかい","은세계 (銀世界)","사방에 눈이 쌓여 은빛처럼 희고 아름다운 곳."]],"銀製":[["ぎんせい","은제 (銀製)","은으로 만듦. 또는 그런 물건."]],"銀河":[["ぎんが","은하 (銀河)","흰 구름 모양으로 길게 보이는 수많은 천체의 무리."]],"銀河系":[["ぎんがけい","은하계 (銀河系)","은하를 이루고 있는 수많은 천체의 집단."]],"銀行":[["ぎんこう","은행 (銀行)","사람들의 돈을 맡아 관리하고 필요한 사람에게 돈을 빌려주는 기관."]],"銀杏":[["ぎんなん","은행 (銀杏)","은행나무의 열매."],["いちょう","은행나무 (銀杏나무)","부채 모양의 잎이 달렸으며 가을이 되면 잎의 색이 노란색으로 변하는, 주로 가로수로 심는 나무."]],"銀行家":[["ぎんこうか","은행가 (銀行家)","은행을 경영하고 관리하는 사람."]],"銀行員":[["ぎんこういん","은행원 (銀行員)","은행에 근무하면서 일을 하는 직원."]],"銀杏の葉":[["いちょうのは","은행잎 (銀杏잎)","부채꼴 모양으로 노란색을 띠는 은행나무의 잎."]],"銀婚式":[["ぎんこんしき","은혼식 (銀婚式)","결혼 25주년을 기념하기 위한 의식."]],"淀み":[["よどみ","웅덩이","땅이 아래로 우묵하게 파여 물이 모여 있는 곳."]],"怠納":[["