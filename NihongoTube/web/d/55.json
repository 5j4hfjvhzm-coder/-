과 똑같이 만든 물건."]],"複製版":[["ふくせいばん","복제판 (複製版)","그림 등의 미술품을 많은 사람들에게 소개하기 위해 원래의 것과 똑같이 만든 것."]],"複製品":[["ふくせいひん","복제품 (複製品)","원래의 것과 똑같이 만든 물품."]],"複製する":[["ふくせいする","복제하다 (複製하다)","원래의 것과 똑같은 것을 만들다."]],"複合":[["ふくごう","복합 (複合)","두 가지 이상이 하나로 합침. 또는 두 가지 이상을 하나로 합침."]],"複合する":[["ふくごうする","복합되다 (複合되다)","두 가지 이상이 하나로 합쳐지다."],["ふくごうする","복합하다 (複合하다)","두 가지 이상이 하나로 합쳐지다. 또는 두 가지 이상을 하나로 합치다."]],"複合語":[["ふくごうご","복합어 (複合語)","둘 이상의 형태소가 합쳐져서 만들어진 단어."]],"複合的":[["ふくごうてき","복합적 (複合的)","두 가지 이상이 하나로 합쳐 있는 것."]],"複合体":[["ふくごうたい","복합체 (複合體)","두 가지 이상의 물체가 합쳐져서 만들어진 물체."]],"複":[["ふく","복- (複)","'단일하지 않은' 또는 '겹친'의 뜻을 더하는 접두사."]],"文字盤":[["もじばん","글자판 (글字板)","컴퓨터나 시계 등에서 글자나 숫자, 기호가 적힌 판."],["もじばん","번호판 (番號板)","전화기에서 숫자가 적혀 있는 판."],["もじばん","글자판 (―字板)"],["もじばん","문자반 (文字盤)"]],"勇み立つ":[["いさみたつ","백배하다 (百倍하다)","용기나 기운 등이 크게 생기다."]],"座布団":[["ざぶとん","방석 (方席)","방바닥, 의자, 소파 등에 앉을 때에 엉덩이 아래에 깔고 앉는 네모지거나 둥근 모양의 깔개."]],"文句なしに":[["もんくなしに","무조건 (無條件)","아무것도 따지지 않고, 특별한 이유나 조건 없이."],["もんくなしに","두말없이"]],"文盲率":[["もんもうりつ","문맹률 (文盲率)","배우지 못하여 글을 읽거나 쓸 줄 모르는 사람의 비율."]],"文盲者":[["もんもうもの","문맹자 (文盲者)","배우지 못하여 글을 읽거나 쓸 줄을 모르는 사람."]],"文明":[["ぶんめい","문명 (文明)","사람의 물질적, 기술적, 사회적 생활이 발전한 상태."]],"文明国":[["ぶんめいこく","문명국 (文明國)","과학 기술이 발달하여 물질적으로 풍부하고 국민들의 의식과 문화 수준이 높은 나라."]],"文明国家":[["ぶんめいこっか","문명국가 (文明國家)","과학 기술이 발달하여 물질적으로 풍부하고 국민들의 의식과 문화 수준이 높은 나라."],["ぶんめいこっか","문명 국가 (文明國家)"]],"文明史":[["ぶんめいし","문명사 (文明史)","인류가 발달시켜 온 문명의 역사."]],"文明社会":[["ぶんめいしゃかい","문명사회 (文明社會)","과학 기술이 발달하여 물질적으로 풍부하고 사람들의 의식과 문화 수준이 높은 사회."]],"文明人":[["ぶんめいじん","문명인 (文明人)","문명이 발달한 사회에서 사는, 의식이 있고 문화 수준이 높은 사람."]],"文明化する":[["ぶんめいかする","문명하다 (文明하다)","기술적, 물질적, 정신적으로 발전되어 있다."]],"文武":[["ぶんぶ","문무 (文武)","문관과 무관."]],"文武百官":[["ぶんぶひゃっかん","문무백관 (文武百官)","문관과 무관을 포함한 모든 관리."],["ぶんぶひゃっかん","문무 백관 (文武百官)"]],"文物":[["ぶんぶつ","문물 (文物)","정치, 경제, 학문, 종교, 예술과 같은 문화의 산물."]],"文民":[["ぶんみん","문민 (文民)","군부 세력과 관계없는 일반 국민."]],"文民政治":[["ぶんみんせいじ","문민정치 (文民政治)","군부 세력과 관계없는 일반 국민에 의한, 일반 국민을 위한 정치."]],"文房具":[["ぶんぼうぐ","문방구 (文房具)","노트, 연필 등 공부를 하거나 사무를 보는 데 필요한 도구."],["ぶんぼうぐ","문구 (文具)","노트, 연필 등 공부를 하거나 사무를 보는 데 필요한 도구."],["ぶんぼうぐ","문방 제구 (文房諸具)"]],"文具":[["ぶんぐ","문구 (文具)","노트, 연필 등 공부를 하거나 사무를 보는 데 필요한 도구."],["ぶんぐ","문방구 (文房具)","노트, 연필 등 공부를 하거나 사무를 보는 데 필요한 도구."]],"文房具屋":[["ぶんぼうぐや","문구점 (文具店)","종이, 연필, 지우개 등의 공부를 하거나 사무를 보는 데에 필요한 물건들을 파는 가게."],["ぶんぼうぐや","문방구 (文房具)","노트, 연필 등 공부를 하거나 사무를 보는 데 필요한 도구를 파는 가게."]],"文房具店":[["ぶんぼうぐてん","문구점 (文具店)","종이, 연필, 지우개 등의 공부를 하거나 사무를 보는 데에 필요한 물건들을 파는 가게."],["ぶんぼうぐてん","문방구 (文房具)","노트, 연필 등 공부를 하거나 사무를 보는 데 필요한 도구를 파는 가게."]],"文房四宝":[["ぶんぼうしほう","문방사우 (文房四友)","문인들이 서재에서 쓰는 종이, 붓, 먹, 벼루의 네 가지 도구."]],"文法":[["ぶんぽう","문법 (文法)","말의 소리, 단어, 문장 등을 쓰는 일정한 규칙. 또는 그것을 연구하는 학문."]],"文法的":[["ぶんぽうてき","문법적 (文法的)","문법에 의한 것. 또는 문법에 맞는 것."]],"文士":[["ぶんし","문사 (文士)","학문을 하는 선비."]],"文書":[["ぶんしょ","문서 (文書)","다른 일의 자료가 되거나 어떤 사실을 증명하는 데 쓰이는 글을 적은 종이."],["ぶんしょ","문건 (文件)","공적인 문서."],["ぶんしょ","글","생각이나 일 등의 내용을 글자로 나타낸 것."],["ぶんしょ","서류 (書類)"]],"文書箱":[["もんじょばこ","문서함 (文書函)","문서를 넣어 보관하는 상자."]],"文書化する":[["ぶんしょかする","문서화하다 (文書化하다)","문서로 만들다."]],"文臣":[["ぶんしん","문신 (文臣)","(옛날에) 신하 가운데 문관인 사람."]],"文案":[["ぶんあん","문안 (文案)","문장이나 서류를 작성하기 위해 대략 쓴 초안."]],"文弱":[["ぶんじゃく","문약 (文弱)","학문만을 중요시하여 정신적으로나 신체적으로 나약한 상태."]],"文弱である":[["ぶんじゃくである","문약하다 (文弱하다)","학문만을 중요시하여 정신적으로나 신체적으로 나약하다."]],"文様":[["もんよう","문양 (文樣)","물건을 장식하기 위해 표면에 그리거나 새겨 넣은 무늬."],["もんよう","무늬","장식하기 위해 넣은 여러 가지 모양."]],"文語":[["ぶんご","문어 (文語)","일상적인 대화가 아닌 글에서 쓰는 말."],["ぶんご","글말","일상적인 대화가 아닌 글에서 쓰는 말."]],"文章語":[["ぶんしょうご","글말","일상적인 대화가 아닌 글에서 쓰는 말."],["ぶんしょうご","문어 (文語)","일상적인 대화가 아닌 글에서 쓰는 말."]],"文字言語":[["もじげんご","문자 언어 (文字言語)","글자로 나타낸 말."],["もじげんご","글말","문자로 표현되어 있는 언어."],["もじげんご","문어 (文語)","문자로 표현되어 있는 언어."]],"文語体":[["ぶんごたい","문어체 (文語體)","일상적인 대화가 아닌 글에서 쓰이는 문체."]],"文芸":[["ぶんげい","문예 (文藝)","문학과 예술."]],"文芸班":[["ぶんげいはん","문예반 (文藝班)","학교에서 문예에 관심이 있는 학생들이 모여 문예를 배우고 그와 관련된 활동을 하는 모임."]],"文芸思潮":[["ぶんげいしちょう","문예 사조 (文藝思潮)","문학이나 예술에 나타나는 사상적인 경향."]],"文芸誌":[["ぶんげいし","문예지 (文藝誌)","시, 소설, 평론 등과 같은 문예 작품이나 그와 관련된 글을 주로 싣는 잡지."]],"文友":[["ぶんゆう","문우 (文友)","글을 통해 사귀게 된 친구."],["ぶんゆう","글벗"]],"文人":[["ぶんじん","문인 (文人)","소설가, 시인, 평론가 등과 같이 문학에 종사하는 사람."],["ぶんじん","사객 (詞客)"]],"文字":[["もじ","문자 (文字)","언어의 소리나 뜻을 눈으로 볼 수 있도록 적은 기호 체계."],["もじ","글씨","써 놓은 글자의 모양."],["もじ","글자 (글字)","말을 적는 기호."],["もじ","글","말의 소리나 뜻을 나타내기 위한 기호, 또는 그런 기호들의 체계."],["もじ","글자 (―字)"]],"文字列":[["もじれつ","문자열 (文字列)","컴퓨터에서, 데이터로 사용하는 문자의 배열."]],"文章家":[["ぶんしょうか","문장 (文章)","글을 짓는 실력이 뛰어난 사람."],["ぶんしょうか","문장가 (文章家)","글을 짓는 실력이 뛰어난 사람."]],"文章力":[["ぶんしょうりょく","문장력 (文章力)","글을 쓰는 능력."],["ぶんしょうりょく","글재주","글을 잘 쓰는 능력."]],"文の成分":[["ぶんのせいぶん","문장 성분 (文章成分)","주어, 서술어, 목적어 등과 같이 한 문장을 구성하는 요소."]],"文才":[["ぶんさい","문재 (文才)","글을 짓는 재주. 또는 글을 잘 짓는 사람."],["ぶんさい","글재주","글을 잘 쓰는 능력."],["ぶんさい","필재 (筆才)"]],"文集":[["ぶんしゅう","문집 (文集)","시나 소설 등의 글을 모아서 엮은 책."]],"文体":[["ぶんたい","문체 (文體)","글쓴이의 개성이나 사상, 또는 글의 종류나 내용에 따라 글에 나타나는 전반적인 특색."]],"文筆":[["ぶんぴつ","문필 (文筆)","글과 글씨."]],"文筆家":[["ぶんぴつか","문필가 (文筆家)","글을 짓는 일을 전문으로 하는 사람."]],"文学":[["ぶんがく","문학 (文學)","시, 소설, 수필, 희곡 등과 같이 사람의 생각이나 감정을 말이나 글로 표현한 예술."],["ぶんがく","글","생각이나 일 등의 내용을 글자로 나타낸 것."]],"文学家":[["ぶんがくか","문학가 (文學家)","문학을 창작하거나 연구하는 사람."]],"文学界":[["ぶんがくかい","문학계 (文學界)","문학과 관련이 있는 사람들의 사회."],["ぶんがくかい","문단 (文壇)"]],"文学徒":[["ぶんがくと","문학도 (文學徒)","문학을 전문적으로 배우고 연구하는 사람."]],"文学賞":[["ぶんがくしょう","문학상 (文學賞)","훌륭한 문학 작품을 썼거나 문학과 관련된 부문에서 뛰어난 공적이 있는 사람에게 주는 상."]],"文学性":[["ぶんがくせい","문학성 (文學性)","문학 작품으로서의 가치나 예술성."]],"文学者":[["ぶんがくしゃ","문학인 (文學人)","문학을 창작하거나 연구하는 사람."]],"文学作品":[["ぶんがくさくひん","문학 작품 (文學作品)","시, 소설, 희곡 등 문학에 속하는 예술 작품."]],"文学的":[["ぶんがくてき","문학적 (文學的)","문학의 특성을 가진 것. 또는 문학과 관련된 것."]],"文献":[["ぶんけん","문헌 (文獻)","옛날의 제도나 문물을 아는 데 증거가 되는 자료나 기록."]],"文献学":[["ぶんけんがく","문헌학 (文獻學)","문헌 자료를 통해 한 민족이나 시대의 문화를 역사적으로 연구하는 학문."]],"文型":[["ぶんけい","문형 (文型)","문장의 구조, 종류, 기능 등에 의해 나누어진 문장의 유형."]],"文豪":[["ぶんごう","문호 (文豪)","뛰어난 문학 작품을 써서 널리 알려진 사람."]],"文化":[["ぶんか","문화 (文化)","사회의 공동체가 일정한 목적 또는 생활 이상을 실현하기 위하여 만들고, 익히고, 공유하고, 전달하는 물질적, 정신적 활동."]],"文化界":[["ぶんかかい","문화계 (文化界)","문화에 관련된 일을 하는 사람들의 활동 분야."]],"文化圏":[["ぶんかけん","문화권 (文化圈)","하나의 공통된 문화를 공유하는 지역."]],"文化部":[["ぶんかぶ","문화부 (文化部)","신문사나 방송국 등에서 문화, 예술과 관련된 기사를 다루는 부서."]],"文化費":[["ぶんかひ","문화비 (文化費)","국가 예산에서 문화나 예술의 발전을 위해 필요로 하는 비용."]],"文化史":[["ぶんかし","문화사 (文化史)","문화의 역사와 발달 과정. 또는 그것을 연구하는 학문."]],"文化生活":[["ぶんかせつかつ","문화생활 (文化生活)","문화와 관련된 활동을 하거나 즐기는 생활."],["ぶんかせつかつ","문화 생활 (文化生活)"]],"文化施設":[["ぶんかしせつ","문화 시설 (文化施設)","극장이나 박물관 등 문화를 누리고 발달시키는 데 필요한 시설."]],"文化語":[["ぶんかご","문화어 (文化語)","북한에서 언어생활의 기준으로 삼는 표준말."]],"文化用品":[["ぶんかようひん","문화용품 (文化用品)","문화적 욕구를 충족하기 위한 여러 가지 물품."]],"文化院":[["ぶんかいん","문화원 (文化院)","한 사회나 조직에서 자신들의 문화를 쉽게 접할 수 있도록 만들거나 각종 문화 생활을 할 수 있도록 만든 공간."]],"文化遺産":[["ぶんかいさん","문화유산 (文化遺産)","문화적인 가치가 높아 후손들에게 물려줄 필요가 있는 문화나 문화재."],["ぶんかいさん","문화 유산 (文化遺産)"]],"文化人":[["ぶんかじん","문화인 (文化人)","지적 수준이 높거나 교양이 있는 사람."]],"文化人類学":[["ぶんかじんるいがく","문화 인류학 (文化人類學)","인류의 생활 방식이나 사회의 관습, 제도 등을 문화의 측면에서 연구하는 학문."]],"文化財":[["ぶんかざい","문화재 (文化財)","문화적 가치가 뛰어나서 법으로 보호를 받거나 받아야 하는 유물 및 유적."]],"文化的":[["ぶんかてき","문화적 (文化的)","문화와 관련된 것."]],"文庫":[["ぶんこ","문고 (文庫)","책을 읽을 수 있도록 모아서 보관하는 곳."],["ぶんこ","서고 (書庫)"]],"文庫本":[["ぶんこぼん","문고본 (文庫本)","책을 널리 보급하기 위해 가지고 다니기 편하도록 작은 크기로 만든 책."],["ぶんこぼん","문고 (文庫)","책을 널리 보급하기 위해 만든, 값이 싸고 크기가 작은 책."]],"文庫判":[["ぶんこばん","문고판 (文庫判)","책을 널리 보급하기 위해 싼 가격에 작은 크기로 만드는 책의 판."]],"文科":[["ぶんか","문과 (文科)","문학, 철학, 심리학, 역사학 등의 인문과 사회 분야를 연구하는 학과. 또는 그런 학문."]],"文官":[["ぶんかん","문관 (文官)","군인이 아니면서, 군대에서 사무를 보는 관리."]],"文具店":[["ぶんぐてん","문구점 (文具店)","종이, 연필, 지우개 등의 공부를 하거나 사무를 보는 데에 필요한 물건들을 파는 가게."]],"文段":[["ぶんだん","문단 (文段)","글에서 여러 문장들이 모여 하나의 완결된 생각을 나타내는 단위."]],"文壇":[["ぶんだん","문단 (文壇)","문학과 관련된 일을 하는 사람들이 활동하는 분야."],["ぶんだん","문원 (文苑)"],["ぶんだん","한묵장 (翰墨場)"]],"文理":[["ぶんり","문리 (文理)","글의 뜻을 깨달아 아는 힘."]],"文脈":[["ぶんみゃく","문맥 (文脈)","서로 이어져 있는 문장의 앞뒤 의미 관계."]],"文盲":[["もんもう","문맹 (文盲)","배우지 못하여 글을 읽거나 쓸 줄을 모름. 또는 그런 사람."],["もんもう","눈뜬장님","글을 보고도 읽을 줄 모르는 사람."],["もんもう","몰자한 (沒字漢)"],["もんもう","목불식정 (目不識丁)"],["もんもう","청맹과니 (靑盲―)"]],"渇く":[["かわく","목마르다","어떤 것을 간절히 원하다."],["かわく","마르다","입이나 목구멍에 침이 줄어들어 물이 마시고 싶어지다."]],"万":[["まん","만 (萬)","천의 열 배가 되는 수."]],"万感":[["ばんかん","만감 (萬感)","떠오르는 온갖 생각이나 느낌."]],"万古":[["ばんこ","만고 (萬古)","아주 오랜 세월."]],"万国":[["ばんこく","만국 (萬國)","세계의 모든 나라."],["ばんこく","만방 (萬邦)"]],"万国旗":[["ばんこくき","만국기 (萬國旗)","세계 여러 나라의 국기."]],"万難":[["ばんなん","만난 (萬難)","온갖 어려움."],["ばんなん","백난 (百難)"]],"万年":[["まんねん","만년 (萬年)","오랜 세월."]],"万年雪":[["まんねんゆき","만년설 (萬年雪)","높은 산꼭대기나 아주 추운 지방에 녹지 않고 항상 쌓여 있는 눈."]],"万年筆":[["まんねんひつ","만년필 (萬年筆)","펜의 몸통에 잉크를 넣어 글씨를 쓸 수 있게 만든 필기도구."]],"万代":[["ばんだい","만대 (萬代)","아주 오랫동안 이어지는 세대."],["ばんだい","만세 (萬世)"]],"万里の他国":[["ばんりのたこく","만리타국 (萬里他國)","자기 나라에서 멀리 떨어진 다른 나라."]],"万里の他郷":[["ばんりのたきょう","만리타향 (萬里他鄕)","자기 나라나 고향에서 멀리 떨어진 다른 지방."]],"万万歳":[["ばんばんざい","만만세 (萬萬歲)","(강조하는 말로) 만세."]],"万物":[["ばんぶつ","만물 (萬物)","세상에 있는 모든 것."],["ばんぶつ","만유 (萬有)","우주에 있는 모든 것."],["ばんぶつ","범물 (凡物)"]],"万民":[["ばんみん","만민 (萬民)","모든 사람."],["ばんみん","만백성 (萬百姓)","나라 안의 모든 백성."],["ばんみん","억조 창생 (億兆蒼生)"]],"万般":[["ばんぱん","만반 (萬般)","미리 갖출 수 있는 모든 것."]],"万方":[["ばんぽう","만방 (萬方)","모든 곳."]],"万邦":[["ばんぽう","만방 (萬邦)","세계의 모든 나라."]],"万姓":[["ばんせい","만백성 (萬百姓)","나라 안의 모든 백성."]],"万病":[["まんびょう","만병 (萬病)","모든 병."],["まんびょう","백병 (百病)"]],"万能薬":[["ばんのうやく","만병통치약 (萬病通治藥)","모든 병을 다 고치는 약."]],"万福":[["ばんぷく","만복 (萬福)","온갖 복."],["ばんぷく","백복 (百福)"]],"万事亨通":[["ばんじこうつう","만사형통 (萬事亨通)","모든 일이 다 바라는 대로 이루어짐."]],"万事うまく行く":[["ばんじうまくいく","만사형통하다 (萬事亨通하다)","모든 일이 다 바라는 대로 이루어지다."]],"万象":[["ばんしょう","만상 (萬象)","세상에 있는 온갖 사물. 또는 온갖 사물의 모양."],["ばんしょう","만유 (萬有)","우주에 있는 모든 것."]],"万石":[["まんごく","만석 (萬石)","아주 많은 곡식."]],"万石取り":[["まんごくどり","만석꾼 (萬石꾼)","(비유적으로) 거두는 곡식이 만 석이 될 만한 논밭을 가진 아주 큰 부자."]],"万世":[["ばんせい","만세 (萬世)","아주 오랫동안 이어지는 후손들의 세대."],["ばんせい","만대 (萬代)"]],"万歳":[["ばんぜい","만세 (萬歲)","오래도록 사는 것."]],"万寿":[["ばんじゅ","만수 (萬壽)","오래 삶."]],"万有":[["ばんゆう","만유 (萬有)","우주에 있는 모든 것."]],"万有引力":[["ばんゆういんりょく","만유인력 (萬有引力)","질량을 가진 모든 물체가 서로 끌어당기는 힘."]],"万人":[["ばんじん","만인 (萬人)","모든 사람."]],"万全":[["ばんぜん","만전 (萬全)","빈틈이 없이 완벽함."]],"万華鏡":[["まんげきょう","만화경 (萬華鏡)","원통 안에 긴 거울을 세모꼴로 붙이고 여러 개의 색종이 조각을 넣어 색채와 무늬가 대칭되게 나타나도록 만든 장난감."]],"照り返す":[["てりかえす","되쏘다","거울 같은 것이 빛을 받아 반사하다."]],"万遍なく":[["まんべんなく","두루","어느 하나에 치우치지 않고 여러 가지를 빠짐없이 골고루."],["まんべんなく","두루두루","여러 가지를 빠짐없이 골고루. 이것저것 모두."]],"文句を言わない":[["もんくをいわない","두말없다","이런저런 불평을 하거나 덧붙이는 말이 없다."]],"文句を言わず":[["もんくをいわず","두말없이","이런저런 불평을 하거나 덧붙이는 말이 없이."]],"斧仕事":[["おのしごと","도끼질","도끼로 나무 등을 자르는 일."]],"斧":[["おの","도끼","굵은 나무를 찍거나 장작을 패는 데 쓰는 연장."],["おの","도끼 (―木手)"]],"斧の刃":[["おののは","도끼날","도끼에서 물건을 찍거나 자르는 데 쓰는 쇠로 된 날카로운 부분."]],"照合":[["しょうごう","대조 (對照)","둘 이상의 것을 맞대어 같고 다름을 살펴봄."]],"照合する":[["しょうごうする","대조하다 (對照하다)","둘 이상의 것을 맞대어 같고 다름을 살펴보다."]],"文の集まりで構成される言葉の単位":[["","담화 (談話)",""]],"砧打ち":[["きぬたうち","다듬이질","옷이나 옷감 등을 방망이로 두드려 구김살을 펴고 매끄럽게 하는 일."],["きぬたうち","다듬질","옷이나 옷감 등을 방망이로 두드려 구김살을 펴고 매끄럽게 하는 일."],["きぬたうち","다듬이","옷이나 옷감 등을 방망이로 두드려 구김살을 펴고 매끄럽게 하는 일."]],"砧を打つ":[["きぬたをうつ","다듬질하다","옷이나 옷감 등을 방망이로 두드려 구김살을 펴고 매끄럽게 하다."]],"座り込み":[["すわりこみ","농성 (籠城)","사람들이 어떤 목적을 이루기 위하여 한곳에 자리를 잡고 시위함."]],"照り付ける":[["てりつける","내리쬐다","햇빛이 아래쪽으로 강하게 비치다."],["てりつける","내리비치다","빛이 위에서 아래로 강하게 비치다."],["てりつける","내리쪼이다","햇빛이 아래쪽으로 강하게 비치다."]],"文言":[["もんごん","글귀 (글句)","몇 글자 또는 몇 단어로 된 짧은 글."],["もんごん","글귀 (←―句)"]],"文筆力":[["ぶんぴつりょく","글재주","글을 잘 쓰는 능력."]],"兇悪":[["きょうあく","극악 (極惡)","더할 나위 없이 악하고 독함."],["きょうあく","흉악 (凶惡)"]],"勧告":[["かんこく","권고 (勸告)","어떤 일을 하도록 동의를 구하며 충고함. 또는 그런 말."],["かんこく","권 (勸)"]],"勧告する":[["かんこくする","권고하다 (勸告하다)","어떤 일을 하도록 동의를 구하며 충고하다."],["かんこくする","권하다 (勸―)"]],"勧勉":[["かんべん","권면 (勸勉)","어떤 일을 하도록 힘써 권하고 충고함."]],"勧告に努める":[["かんこくにつとめる","권면하다 (勸勉하다)","어떤 일을 하라고 힘써 권하고 충고하다."]],"勧士":[["けんし","권사 (勸師/勸事/勸士)","기독교에서, 목사나 전도사 등을 도와 다른 교인들을 돌보며 위로하는 직책. 또는 그런 사람."]],"勧善懲悪":[["かんせんちょうあく","권선징악 (勸善懲惡)","착한 일을 권장하고 못된 일을 벌하는 것."]],"勧誘する":[["かんゆうする","권유하다 (勸誘하다)","어떤 것을 하라고 권하다."]],"勧奨":[["かんしょう","권장 (勸奬)","어떤 일을 권하고 장려함."]],"勧奨される":[["かんしょうされる","권장되다 (勸奬되다)","어떤 일이 권해지고 장려되다."]],"勧奨する":[["かんしょうする","권장하다 (勸奬하다)","어떤 일을 권하고 장려하다."]],"勧める":[["すすめる","권하다 (勸하다)","어떤 사람에게 좋다고 여겨지는 일을 하도록 하다."],["すすめる","권하다 (勸―)"]],"控除":[["こうじょ","공제 (控除)","전체 몫에서 일정한 금액이나 수량을 빼거나 뗌."]],"控除される":[["こうじょされる","공제되다 (控除되다)","전체 몫에서 일정한 금액이나 수량이 빠지거나 떼이다."]],"控除する":[["こうじょする","공제하다 (控除하다)","전체 몫에서 일정한 금액이나 수량을 빼거나 떼다."]],"誇張的":[["こちょうてき","과장적 (誇張的)","사실에 비해 지나치게 부풀려 나타내는 것."]],"誇大妄想":[["こだいもうそう","과대망상 (誇大妄想)","사실보다 지나치게 부풀려서 생각하고 그것을 사실로 믿어 버리는 증상."],[