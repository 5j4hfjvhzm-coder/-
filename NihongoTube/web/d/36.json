{"薄黒い":[["うすぐろい","거멓다","어둡고 옅게 검다."],["うすぐろい","가맣다","밝고 옅게 검다."],["うすぐろい","거무레하다","엷게 검은 빛이 조금 나다."],["うすぐろい","거무스름하다","검은 빛깔이 조금 나다."],["うすぐろい","까무퇴퇴하다","색깔이 지저분하게 보일 정도로 어둡고 짙다."],["うすぐろい","가뭇가뭇하다","군데군데 빛깔이 조금 밝고 옅게 검다."],["うすぐろい","가무레하다"]],"鋤":[["すき","가래","흙을 떠서 던지는 데 쓰는 도구."],["すき","쟁기","논밭을 가는 농기구."]],"鋤き起こし":[["すきおこし","가래질","가래로 흙을 파헤치거나 흙을 떠서 던지는 일."]],"勤まる":[["つとまる","감당하다 (堪當하다)","어떤 일을 맡아 자기 능력으로 해내다."]],"堤防":[["ていぼう","강둑 (江둑)","강물이 넘치지 않게 하려고 흙과 돌 등으로 강을 따라 길게 쌓아 올린 둑."],["ていぼう","제방 (堤防)","강이나 바다, 호수 등의 물이 넘쳐흐르는 것을 막기 위해 흙이나 돌, 콘크리트 등을 쌓아 만든 시설."],["ていぼう","방죽","물이 밀려드는 것을 막기 위해 쌓은 둑."],["ていぼう","둑","하천이나 호수의 물이 흘러넘치는 것을 막기 위해서 돌이나 흙 등으로 높이 막아 쌓은 긴 언덕."],["ていぼう","방죽 (防―)"]],"堤":[["つつみ","둑","하천이나 호수의 물이 흘러넘치는 것을 막기 위해서 돌이나 흙 등으로 높이 막아 쌓은 긴 언덕."],["つつみ","강둑 (江둑)","강물이 넘치지 않게 하려고 흙과 돌 등으로 강을 따라 길게 쌓아 올린 둑."],["つつみ","제방 (堤防)","강이나 바다, 호수 등의 물이 넘쳐흐르는 것을 막기 위해 흙이나 돌, 콘크리트 등을 쌓아 만든 시설."],["つつみ","방죽","물이 밀려드는 것을 막기 위해 쌓은 둑."],["つつみ","방죽 (防―)"]],"弄ぶ":[["もてあそぶ","어르다","사람이나 동물을 놀리며 장난하다."],["もてあそぶ","주무르다","다른 사람이나 일 등을 제 마음대로 다루거나 놀리다."],["もてあそぶ","후리다","매력으로 남을 유혹해 정신을 매우 흐리게 하다."]],"薄明るい":[["うすあかるい","훤하다","조금 흐릿하게 밝다."],["うすあかるい","번하다","어두운 가운데 조금 훤하다."],["うすあかるい","희붐하다"]],"薄明るく":[["うすあかるく","훤히","조금 흐릿할 정도로 밝게."]],"薄暗い":[["うすぐらい","침침하다 (沈沈하다)","빛이 약하여 어둡고 컴컴하다."],["うすぐらい","어둑어둑","사물을 분명히 알아볼 수 없을 정도로 어두운 모양."],["うすぐらい","어둑하다","꽤 어둡다."],["うすぐらい","어둑어둑하다","사물을 분명히 알아볼 수 없을 정도로 어둡다."],["うすぐらい","어둠침침하다","어두워 시야가 흐릿하다."],["うすぐらい","어스름하다","조금 어둡다."],["うすぐらい","흐리다","불빛이 밝지 않다."],["うすぐらい","어스레하다"],["うすぐらい","어두컴컴하다"]],"薄ぼんやりする":[["うすぼんやりする","흐릿하다","뚜렷하지 않고 어렴풋하다."],["うすぼんやりする","어렴풋하다","기억이나 생각 등이 분명하지 않고 흐릿하다."],["うすぼんやりする","어슴푸레하다","분명하게 잘 보이거나 들리지 않고 희미하고 흐리다."]],"黄金":[["おうごん","황금 (黃金)","누런빛의 금."],["おうごん","금 (金)","화려한 광택이 나는 노란색의 귀금속."]],"黄金期":[["おうごんき","황금기 (黃金期)","최고의 경지에 올라 가장 좋은 시기."]],"黄金万能主義":[["おうごんばんのうしゅぎ","황금만능주의 (黃金萬能主義)","돈이 가장 중요하며 돈으로 무엇이든지 마음대로 할 수 있다고 믿는 사고방식이나 태도."]],"黄金の波":[["こがねのなみ","황금물결 (黃金물결)","(비유적으로) 누렇게 익은 벼가 바람에 흔들리는 모습."]],"黄金分割":[["おうごんぶんかつ","황금 분할 (黃金分割)","한 선분을 둘로 나눌 때, 전체에 대한 큰 부분의 비와 큰 부분에 대한 작은 부분의 비가 같도록 나눈 것."]],"黄金比":[["おうごんひ","황금비 (黃金比)","한 선분을 둘로 나눌 때, 전체에 대한 큰 부분의 비와 큰 부분에 대한 작은 부분의 비가 같게 한 비율."]],"黄金の光":[["おうごんのひかり","황금빛 (黃金빛)","황금의 색과 같은 누런빛."]],"黄金色":[["こがねいろ","황금색 (黃金色)","황금의 색과 같은 누런색."],["こがねいろ","누르다","황금의 색과 같이 조금 탁하면서도 밝게 노랗다."],["こがねいろ","누런색 (누런色)","어둡고 흐린 빛이 섞인 노란색."],["こがねいろ","금빛 (金빛)","황금처럼 누렇고 반짝이는 빛."],["こがねいろ","금색 (金色)","금과 같이 누렇고 반짝이는 빛깔."],["こがねいろ","금빛 (金―)"],["こがねいろ","노르다"]],"黄金時代":[["おうごんじだい","황금시대 (黃金時代)","사회가 가장 발달되어 행복과 평화가 가득 찬 시대."],["おうごんじだい","황금 시대 (黃金時代)"]],"黄疸":[["おうだん","황달 (黃疸)","온몸과 눈 등이 누렇게 되는 병."]],"黄桃":[["おうとう","황도 (黃桃)","속살이 노란 복숭아."]],"黄砂":[["こうさ","황사 (黃沙/黃砂)","누런 모래."]],"黄土色":[["おうどいろ","황색 (黃色)","어둡고 흐린 빛이 섞인 노란색."],["おうどいろ","황토색 (黃土色)","황토의 빛깔과 같이 누런빛을 띤 갈색."]],"黄色人種":[["おうしょくじんしゅ","황인종 (黃人種)","피부색이 황색인 인종."],["おうしょくじんしゅ","황색 인종 (黃色人種)"]],"黄土":[["おうど","황토 (黃土)","누렇고 거무스름한 흙."]],"黄海":[["ファンへ","황해 (黃海)","한국의 서쪽에 있는 바다. 한반도와 중국에 둘러싸여 있으며 중국 내륙에서 흘러 오는 황토 때문에 바닷물이 누렇다. 밀물과 썰물 때의 수위의 차가 심하여 간석지가 발달해 있다."]],"黄海南道":[["ファンへナムド","황해남도 (黃海南道)","한반도 중서부에 있는 도. 북한이 1954년에 황해도에서 분리하여 신설하였다. 주요 도시로는 해주가 있다."]],"黄海道":[["ファンへド","황해도 (黃海道)","우리나라 중서부에 있는 도. 쌀, 사과, 조기가 많이 나며 온천이 유명하다. 현재 북한에서는 황해남도와 황해북도로 나뉘어 있다."]],"黄海北道":[["ファンへブクド","황해북도 (黃海北道)","한반도 중부 내륙 지방인 도. 북한이 1954년에 황해도에서 분리하여 신설하였다. 주요 도시로는 사리원 등이 있다."]],"黄昏":[["たそがれ","황혼 (黃昏)","해가 지고 조금씩 어두워지는 때. 또는 그때의 빛."],["たそがれ","황혼기 (黃昏期)","(비유적으로) 사람의 생애나 나라의 운명 등이 한창인 고비를 지나 점점 약해져 마지막에 이른 때."],["たそがれ","땅거미","해가 진 후 밤이 되기 전까지 조금 어두운 상태."],["たそがれ","해거름","해가 서쪽으로 넘어가는 일. 또는 그런 때."],["たそがれ","석양 (夕陽)","저녁때의 해가 질 무렵."]],"黄昏時":[["たそがれどき","황혼기 (黃昏期)","(비유적으로) 사람의 생애나 나라의 운명 등이 한창인 고비를 지나 점점 약해져 마지막에 이른 때."]],"黄色":[["こうしょく","황 (黃)","어둡고 흐린 빛이 섞인 노란색."],["きいろ","노랑","바나나나 레몬과 같은 색."],["きいろ","노란색 (노란色)","병아리나 바나나와 같은 색."],["こうしょく","누렁"],["こうしょく","황색 (黃色)"],["こうしょく","노란빛"]],"瘤":[["こぶ","혹","병적으로 튀어나온 살덩어리."]],"兄":[["あに","형 (兄)","남자가 형제나 친척 형제들 중에서 자기보다 나이가 많은 남자를 이르거나 부르는 말."],["あに","오라비","(낮춤말로) 오라버니."],["あに","오빠","여자가 형제나 친척 형제들 중에서 자기보다 나이가 많은 남자를 이르거나 부르는 말."]],"兄貴":[["あにき","형 (兄)","남자가 형제나 친척 형제들 중에서 자기보다 나이가 많은 남자를 이르거나 부르는 말."],["あにき","형님 (兄님)","(높임말로) 남자가 형제나 친척 형제들 중에서 자기보다 나이가 많은 남자를 이르거나 부르는 말."]],"兄さん":[["にいさん","형님 (兄님)","(높임말로) 남자가 형제나 친척 형제들 중에서 자기보다 나이가 많은 남자를 이르거나 부르는 말."]],"兄上":[["あにうえ","형님 (兄님)","아내의 오빠를 이르거나 부르는 말."]],"兄嫁":[["あによめ","형수 (兄嫂)","가족이나 친척 사이에서 형의 아내를 이르거나 부르는 말."]],"兄弟":[["きょうだい","형제 (兄弟)","형과 남동생."],["きょうだい","오라비","여자의 남자 형제."]],"兄弟愛":[["きょうだいあい","형제애 (兄弟愛)","형제 사이의 사랑."]],"兄弟姉妹":[["きょうだいしまい","형제자매 (兄弟姊妹)","남자 형제와 여자 형제."],["きょうだいしまい","동기 (同氣)"],["きょうだいしまい","한동기 (─同氣)"],["きょうだいしまい","형제 자매 (兄弟姉妹)"]],"兄弟の間":[["きょうだいのあいだ","형제지간 (兄弟之間)","형과 남동생 사이."]],"組み合わせ":[["くみあわせ","합 (合)","여럿이 한데 모임. 또는 여럿을 한데 모음."],["くみあわせ","조합 (組合)","여럿을 한데 모아 한 덩어리로 짬."]],"組":[["くみ","학급 (學級)","한 교실에서 공부하는 학생의 집단."],["くみ","조 (組)","어떤 목적을 위해서 모인, 비교적 적은 수의 사람들로 이루어진 집단."],["くみ","팀 (team)","같은 일을 함께하는 한 무리."],["くみ","켤레","신발, 양말, 장갑 등 짝이 되는 두 개를 한 벌로 세는 단위."],["くみ","쌍 (雙)","둘을 하나로 묶어 세는 단위."],["くみ","반 (班)","학교에서 한 학년을 교실 단위로 나눈 집단."],["くみ","패 (牌)"]],"潤い":[["うるおい","해갈 (解渴)","목마름을 해결하여 없애 버림."]],"潤う":[["うるおう","해갈되다 (解渴되다)","목마름이 해결되어 없어지다."]],"潤す":[["うるおす","해갈하다 (解渴하다)","목마름을 해결하여 없애 버리다."],["うるおす","축이다"]],"澄む":[["すむ","맑아지다","지저분하고 더러운 것이 사라져 깨끗해지다."],["すむ","해맑다","소리가 탁하지 않고 경쾌하다."],["すむ","맑다","소리 등이 밝고 분명하다."],["すむ","말개지다"]],"約":[["やく","약 (約)","어떤 수량에 가까움을 나타내는 말."],["やく","한","대충 어림하여 대략."]],"黄金虫":[["こがねむし","풍뎅이","몸이 딱딱하고 둥글넓적하며, 금빛 광택이 나는 짙은 녹색이나 보라색인 곤충."]],"的":[["まと","과녁","주로 총이나 활 등을 쏠 때 표적으로 세우는 것."],["まと","표적 (標的)","목표로 삼는 물건."],["まと","표적물 (標的物)","쏘아 맞힐 물건."],["まと","과녁판 (과녁板)","총이나 활 등을 쏠 때 표적으로 세우는 판."],["まと","핀트 (←pinto)","말의 요점."],["てき","-적 (的)","'그 성격을 띠는', '그에 관계된', '그 상태로 된'의 뜻을 더하는 접미사."]],"薄青い":[["うすあおい","파르스름하다","약간 파랗다."],["うすあおい","파르무레하다"]],"駄目になる":[["だめになる","못쓰다","건강이 나빠지거나 걱정이 많아 몸이나 얼굴 등에서 살이 빠지다."],["だめになる","망가지다","부서지거나 깨지거나 또는 고장이 나서 완전히 못 쓰게 되다."],["だめになる","망하다 (亡하다)","개인이나 집단이 제 구실을 하지 못하여 흩어지거나 없어지다."],["だめになる","틀어지다","하려던 일이 잘못되어 어긋나다."],["だめになる","결딴나다","나라, 집안, 사업 등이 완전히 망하다