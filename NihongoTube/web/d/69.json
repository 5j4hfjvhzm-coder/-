{"動きが微々だ":[["","가늘다",""]],"動きが微々":[["","가늘다",""]],"動く":[["うごく","동하다 (動하다)","욕구나 감정 등이 생기다."],["うごく","움직대다","몸이나 몸의 일부가 자꾸 움직이다. 또는 몸이나 몸의 일부를 자꾸 움직이다."],["うごく","움직이다","위치나 자세가 바뀌다. 또는 위치나 자세를 바꾸다."],["うごく","움직거리다","몸이나 몸의 일부가 자꾸 움직이다. 또는 몸이나 몸의 일부를 자꾸 움직이다."],["うごく","움직움직하다","몸이나 몸의 일부가 자꾸 움직이다. 또는 몸이나 몸의 일부를 자꾸 움직이다."],["うごく","돌아가다","일이나 형편이 어떤 상태로 되어 가다."],["うごく","돌다","기계나 기관의 기능이 제대로 작동하다."],["うごく","가다","기계 등이 움직이거나 작동하다."],["うごく","놀다","엄마 배 속에 있는 아기가 움직이다."]],"何かがうまく行くように手伝う土台":[["","거름",""]],"何かを対象にする":[["","갖다","15.もつ【持つ】"],["","가지다","11.もつ【持つ】"]],"耕す":[["たがやす","갈다","농기구로 논밭의 땅을 파서 뒤집다."],["たがやす","일구다","농사를 짓기 위해 땅을 파서 일으키다."],["たがやす","경작하다 (耕作하다)","논밭을 갈아 농사를 짓다."],["たがやす","가다루다"],["たがやす","그루뒤다"]],"耕作する":[["こうさくする","부치다","논밭을 갈아 농사를 짓다."],["こうさくする","경작하다 (耕作하다)","논밭을 갈아 농사를 짓다."],["こうさくする","농사짓다 (農事짓다)","곡식이나 채소를 키우기 위해 땅에 씨를 뿌리고 거두는 등의 일을 하다."],["こうさくする","갈다","소규모로 농작물을 심어 기르다."],["こうさくする","농사짓다 (農事-)"],["こうさくする","부침하다"]],"耕し返す":[["たがやしかえす","갈아엎다","땅을 갈아서 흙을 뒤집어엎다."]],"耕し":[["たがやし","갈이","소나 기계로 논밭을 가는 일."]],"幕":[["まく","막 (幕)","비바람을 겨우 피할 수 있을 정도로 대충 지은 집."],["まく","휘장 (揮帳)","넓은 천을 여러 폭으로 이어서 주위를 빙 둘러치는 막."],["まく","장막 (帳幕)"],["まく","판"],["まく","포장 (布帳)"]],"動かす":[["うごかす","움직대다","몸이나 몸의 일부가 자꾸 움직이다. 또는 몸이나 몸의 일부를 자꾸 움직이다."],["うごかす","움직이다","위치나 자세가 바뀌다. 또는 위치나 자세를 바꾸다."],["うごかす","움직거리다","몸이나 몸의 일부가 자꾸 움직이다. 또는 몸이나 몸의 일부를 자꾸 움직이다."],["うごかす","움직움직하다","몸이나 몸의 일부가 자꾸 움직이다. 또는 몸이나 몸의 일부를 자꾸 움직이다."],["うごかす","돌리다","제 기능을 하게 하다."],["うごかす","추스르다","몸을 잘 가다듬어 움직이다."],["うごかす","흔들다","무엇을 자기 마음대로 움직이게 하다."],["うごかす","끗다"]],"痕跡":[["こんせき","흔적 (痕跡/痕迹)","사물이나 현상이 없어지거나 지나간 뒤에 남겨진 것."],["こんせき","자국","다른 것이 닿거나 묻어서 생긴 자리. 또는 어떤 것 때문에 원래의 상태가 달라진 흔적."],["こんせき","자리","사람의 몸이나 물건 등이 변화를 겪고 난 후 흔적이 남은 곳."],["こんせき","뒷자리","어떤 일을 한 뒤에 남은 흔적."],["こんせき","잔흔 (殘痕)"],["こんせき","흔적 (痕迹·痕跡)"]],"瑕":[["きず","손상 (損傷)","어떤 물건이 깨지거나 상함."],["きず","흉","남에게 비웃음을 살 만한 말이나 행동."]],"動向":[["どうこう","향배 (向背)","어떤 일이 일정한 방향으로 나아가는 경향. 또는 어떤 일에 대한 사람들의 태도."],["どうこう","동향 (動向)","개인이나 집단의 사상이나 활동, 일이 되어 가는 형편 등이 움직여 가는 방향."],["どうこう","움직임","어떤 목적을 가지고 활동함."]],"恵沢":[["けいたく","혜택 (惠澤)","제도나 환경, 다른 사람 등으로부터 받는 도움이나 이익."]],"涵養":[["かんよう","함양 (涵養)","지식이나 능력, 성품 등을 기르고 닦음."]],"涵養される":[["かんようされる","함양되다 (涵養되다)","지식이나 능력, 성품 등이 길러지고 닦이다."]],"涵養する":[["かんようする","함양하다 (涵養하다)","지식이나 능력, 성품 등을 기르고 닦다."]],"併合":[["へいごう","병합 (倂合)","둘 이상의 조직이나 나라 등이 하나로 합쳐짐. 또는 그렇게 만듦."],["へいごう","합방 (合邦)","둘 이상의 나라가 하나로 합쳐짐. 또는 둘 이상의 나라를 합침."],["へいごう","합병 (合倂·合幷)"]],"併合される":[["へいごうされる","병합되다 (倂合되다)","둘 이상의 조직이나 나라 등이 하나로 합쳐지다."],["へいごうされる","합방되다 (合邦되다)","둘 이상의 나라가 하나로 합쳐지다."]],"併合する":[["へいごうする","병합하다 (倂合하다)","둘 이상의 조직이나 나라 등이 하나로 합쳐지다. 또는 그렇게 만들다."],["へいごうする","합방하다 (合邦하다)","둘 이상의 나라가 하나로 합쳐지다. 또는 둘 이상의 나라를 합치다."],["へいごうする","합뜨리다 (合―)"]],"何の":[["なんの","하등 (何等)","‘아무런’, ‘아무’ 또는 '얼마만큼'의 뜻을 나타내는 말."],["なんの","아무런","전혀 어떠한."],["どの","어떤","주어진 여러 사람이나 사물 중에서 대상으로 삼는 것이 무엇인지 물을 때 쓰는 말."],["なんの","어쩌다","‘무슨’, ‘웬’의 뜻을 나타내는 말."],["なんの","아무","전혀 어떠한."],["なんの","무슨","예상 밖의 못마땅한 일을 강조할 때 쓰는 말."]],"何ら":[["なんら","하등 (何等)","‘아무런’, ‘아무’ 또는 '얼마만큼'의 뜻을 나타내는 말."],["なんら","아무","전혀 어떠한."]],"何はともあれ":[["なにはともあれ","하여간 (何如間)","일이 어떻게 되었든지. 또는 어떤 이유가 있든지 상관없이."],["なにはともあれ","하여튼 (何如튼)","무엇이 어떻게 되어 있든."],["なにはともあれ","좌우간 (左右間)","이렇든 저렇든 어떻든 간."],["なにはともあれ","아무튼","무엇이 어떻게 되어 있든."],["なにはともあれ","좌우지간 (左右之間)","이렇든 저렇든 어떻든 간."],["なにはともあれ","아무튼지","무엇이 어떻게 되어 있든지."],["なにはともあれ","암튼","무엇이 어떻게 되어 있든."],["なにはともあれ","우선 (于先)","아쉬운 대로."]],"瑕疵":[["かし","하자 (瑕疵)","물건 등의 깨지거나 잘못된 부분."]],"評点":[["ひょうてん","평점 (評點)","학력을 평가하여 매긴 점수."],["ひょうてん","학점 (學點)","대학 또는 대학원에서 성적을 표시하는 단위."]],"動員する":[["どういんする","동원하다 (動員하다)","어떤 목적을 이루려고 사람이나 물건, 방법 등을 한데 모으다."],["どういんする","풀어놓다","어떤 목적을 이루려고 사람을 널리 모으다."],["どういんする","풀다","무엇을 찾기 위해 사람들을 동원해 여기저기로 보내다."]],"評":[["ひょう","평 (評)","좋고 나쁨, 잘하고 못함, 옳고 그름 등을 평가함. 또는 그런 말."]],"評価":[["ひょうか","평가 (評價)","사물의 값이나 가치, 수준 등을 헤아려 정함. 또는 그 값이나 가치, 수준."],["ひょうか","이야기","어떠한 것에 대한 소문을 내거나 평을 하는 말."]],"評価団":[["ひょうかだん","평가단 (評價團)","사물의 값이나 가치, 수준 등을 헤아려 정하는 단체나 집단."]],"評価グループ":[["ひょうかグループ","평가단 (評價團)","사물의 값이나 가치, 수준 등을 헤아려 정하는 단체나 집단."]],"評価される":[["ひょうかされる","평가되다 (評價되다)"