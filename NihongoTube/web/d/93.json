{"納める":[["おさめる","물다","갚아야 할 것을 내주다."],["おさめる","바치다","반드시 내거나 물어야 할 돈을 가져다주다."],["おさめる","걷다","여러 사람에게서 돈이나 물건을 받아서 모으다."],["おさめる","거두다","여러 사람에게서 돈이나 물건을 받아서 모으다."],["おさめる","소화하다 (消化하다)","(비유적으로) 어떤 대상을 일정한 장소에 수용하다."],["おさめる","거둬들이다","사람들에게서 돈이나 물건 등을 받아서 들여오다."],["おさめる","소화시키다 (消化시키다)","(비유적으로) 어떤 대상을 일정한 장소에 수용하다."],["おさめる","거두어들이다","사람들에게서 돈이나 물건 등을 받아서 들여오다."]],"納められる":[["おさめられる","걷히다","여러 사람에게서 돈이나 물건 등이 모아지다."],["おさめられる","소화되다 (消化되다)","(비유적으로) 어떤 대상이 일정한 장소에 수용되다."]],"位":[["くらい","줄","거의 비슷한 수준이나 정도임을 나타내는 말."],["い","위 (位)","등급이나 등수를 나타내는 단위."],["くらい","만치","앞의 내용과 같은 양이나 정도임을 나타내는 말."],["くらい","만큼","앞의 내용과 같은 양이나 정도임을 나타내는 말."],["くらい","언저리","어떤 나이나 시간의 앞뒤."],["くらい","자리","수학에서, 숫자의 위치."],["くらい","이나","수량이나 정도를 대강 짐작할 때 쓰는 조사."],["くらい","-쯤","‘정도’의 뜻을 더하는 접미사."],["くらい","-가량 (假量)","‘정도’의 뜻을 더하는 접미사."],["くらい","-까짓","업신여기는 뜻에서 ‘…만 한 정도의’의 뜻을 더하는 접미사."],["くらい","-경 (頃)","‘그 일에 걸리는 정도의 시간’의 뜻을 더하는 접미사."]],"降雨":[["こうう","강우 (降雨)","비가 내리는 것."]],"降雨量":[["こううりょう","강우량 (降雨量)","일정 기간 동안 일정한 곳에 내린 비의 양."]],"降板":[["こうばん","강판 (降板)","야구에서 투수가 상대편에게 점수를 많이 허용하거나 공을 잘 던지지 못해 경기에서 물러나는 것."],["こうばん","도중하차 (途中下車)","(비유적으로) 어떤 일을 하다가 중간에 그만둠."]],"降下":[["こうか","강하 (降下)","높은 곳에서 아래쪽으로 내려옴."],["こうか","하강 (下降)","높은 곳에서 아래를 향하여 내려옴."]],"降下する":[["こうかする","강하하다 (降下하다)","높은 곳에서 아래쪽으로 내려오다."],["こうかする","하강하다 (下降하다)","높은 곳에서 아래를 향하여 내려오다."]],"鋭い":[["するどい","날카롭다","끝이 가늘어져 뾰족하거나 날이 서 있다."],["するどい","첨예하다 (尖銳하다)","상황이나 사태가 날카롭고 거세다."],["するどい","예리하다 (銳利하다)","끝이 가늘고 뾰족하거나 날카롭다."],["するどい","예민하다 (銳敏하다)","무엇인가를 느끼거나 분석하고 판단하는 능력이 매우 빠르고 뛰어나다."],["するどい","뾰족하다","물체의 끝이 가늘고 날카롭다."],["するどい","뾰쪽하다","물체의 끝이 매우 가늘고 날카롭다."],["するどい","뾰족뾰족하다","여럿이 다 끝이 가늘고 날카롭다."],["するどい","통절하다 (痛切하다)","매우 적절하다."],["するどい","퍼렇다","칼이나 연장의 날이 아주 날카롭다."],["するどい","시퍼렇다","칼날 등이 매우 날카롭다."],["するどい","거칠다","돌이 날카롭다."],["するどい","새파랗다","날이 매우 날카롭다."],["するどい","예각적 (銳角的)"]],"狭苦しい":[["せまくるしい","좁디좁다","매우 좁다."],["せまくるしい","비좁다","공간이나 자리가 매우 좁다."],["せまくるしい","좁다랗다","폭이나 공간이 매우 좁다."],["せまくるしい","갑갑하다","공간이 좁아 답답하다."],["せまくるしい","옹색하다 (壅塞하다)","공간이 비좁고 답답하다."]],"降等":[["こうとう","강등 (降等)","등급이나 계급이 낮아짐. 또는 등급이나 계급을 낮춤."]],"降等される":[["こうとうされる","강등되다 (降等되다)","등급이나 계급이 낮아지다."]],"降等する":[["こうとうする","강등하다 (降等하다)","등급이나 계급을 낮추다."]],"降臨":[["こうりん","강림 (降臨)","신이 하늘에서 인간 세상으로 내려옴."],["こうりん","하강 (下降)","신선이 인간 세상으로 내려오거나 웃어른이 아랫자리로 내려옴."]],"降臨する":[["こうりんする","강림하다 (降臨하다)","신이 하늘에서 인간 세상으로 내려오다."],["こうりんする","하강하다 (下降하다)","신선이 인간 세상으로 내려오거나 웃어른이 아랫자리로 내려오다."],["こうりんする","임하다 (臨하다)","신의 사랑이나 신의 뜻이 인간 또는 인간 세계에 미치다."]],"降雪":[["こうせつ","강설 (降雪)","눈이 내림."]],"降雪量":[["こうせつりょう","강설량 (降雪量)","일정한 기간 동안 일정한 곳에 내린 눈의 양."]],"降水量":[["こうすいりょう","강수량 (降水量)","일정한 기간 동안 일정한 곳에 비나 눈 등이 내려 생기는 물의 양."]],"降神":[["カンシン","강신 (降神)","제사를 지내는 절차의 하나로 처음에 향을 피우고 술을 잔에 따라 붓는 일."]],"降霊":[["こうれい","강신 (降神)","기도나 주문으로 신을 초대하여 자기 몸 안에 내리게 함."]],"蛍":[["ほたる","반디","꽁무니에서 빛을 내며 날아다니는 곤충."],["ほたる","개똥벌레","꽁무니에서 빛을 내며 날아다니는 곤충."],["ほたる","반딧불이","꽁무니에서 빛을 내며 날아다니는 곤충."],["ほたる","반딧불","꽁무니에서 빛을 내며 날아다니는 곤충."]],"ロッキングチェア":[["","흔들의자 (흔들椅子)","앉아서 앞뒤로 흔들 수 있는 의자."]],"禍根":[["かこん","화근 (禍根)","불행한 일이 생긴 원인."]],"鞭":[["むち","채찍","가느다란 막대기의 끝에 노끈이나 가죽끈을 달아 말이나 소를 때려 모는 데 쓰는 물건."],["むち","매","사람이나 짐승을 때리는 막대기. 또는 그것으로 때리는 일."],["むち","회초리","사람이나 동물을 때릴 때에 쓰는 가는 나뭇가지."],["むち","채","팽이나 공 등을 치는 데에 쓰는 도구."]],"恍惚":[["こうこつ","황홀 (恍惚/慌惚)","눈이 부셔 흐릿하게 보일 정도로 아름답고 화려함."],["こうこつ","황홀하다 (恍惚/慌惚하다)","눈이 부셔 흐릿하게 보일 정도로 아름답고 화려하다."],["こうこつ","황홀 (恍惚·怳惚·慌惚)"]],"恍惚感":[["こうこつかん","황홀감 (恍惚感)","마음이나 시선을 빼앗겨 흥분된 느낌."]],"恍惚境":[["こうこつきょう","황홀경 (恍惚境)","마음이나 시선을 빼앗겨 흥분된 경지나 지경."]],"恍惚だ":[["こうこつだ","황홀하다 (恍惚/慌惚하다)","눈이 부셔 흐릿하게 보일 정도로 아름답고 화려하다."]],"恍惚に":[["こうこつに","황홀히 (恍惚/慌惚히)","눈이 부셔 흐릿하게 보일 정도로 아름답고 화려하게."]],"狭軌":[["きょうき","협궤 (狹軌)","철길에서 두 선로의 간격이 표준보다 좁은 선로."]],"狭小":[["きょうしょう","협소하다 (狹小하다)","공간이 작고 비좁다."],["きょうしょう","협소 (狹小)"]],"狭心症":[["きょうしんしょう","협심증 (狹心症)","심장에 갑자기 일어나는 심한 통증이나 발작 증상."]],"狭義":[["きょうぎ","협의 (狹義)","어떤 말의 뜻을 정의할 때에, 좁은 의미."]],"母音":[["ぼいん","모음 (母音)","사람이 목청을 울려 내는 소리로, 공기의 흐름이 방해를 받지 않고 나는 소리."],["ぼいん","홀소리","사람이 목청을 울려 내는 소리로, 공기의 흐름이 방해를 받지 않고 나는 소리."]],"蛍光":[["けいこう","형광 (螢光)","어떤 물체가 엑스선이나 전자 빔 등을 받았을 때 내는 고유한 빛."],[