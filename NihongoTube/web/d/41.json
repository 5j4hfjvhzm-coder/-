される","교육되다 (敎育되다)","지식, 교양, 기술 등의 가르침을 받아 능력이 키워지다."]],"教育目標":[["きょういくもくひょう","교육 목표 (敎育目標)","교육을 통하여 이루고자 하는 것."]],"教育法":[["きょういくほう","교육법 (敎育法)","교육에 관한 기본 법률."]],"教育部":[["きょういくぶ","교육부 (敎育部)","한 나라의 교육과 관련된 일을 맡아보는 정부의 부서."]],"教育費":[["きょういくひ","교육비 (敎育費)","교육에 드는 비용."]],"教育させる":[["きょういくさせる","교육시키다 (敎育시키다)","개인의 능력을 키우기 위해 지식, 교양, 기술 등의 가르침을 받게 하다."]],"教育実習":[["きょういくじっしゅう","교육 실습 (敎育實習)","교사가 되려고 하는 학생이 일정한 기간 동안 학교에 나가 교육 활동을 체험해 보는 교직 과정."]],"教育熱":[["きょういくねつ","교육열 (敎育熱)","교육에 대한 열의."]],"教育用":[["きょういくよう","교육용 (敎育用)","교육을 목적으로 쓰임."]],"教育者":[["きょういくしゃ","교육자 (敎育者)","교육에 종사하는 사람."]],"教育的":[["きょういくてき","교육적 (敎育的)","교육과 관련되거나 교육에 도움이 되는 것."]],"教育哲学":[["きょういくてつがく","교육 철학 (敎育哲學)","교육의 개념과 목적, 기본 원리를 철학적으로 연구하는 학문."]],"教育庁":[["きょういくちょう","교육청 (敎育廳)","시나 군을 단위로 하여 학교의 교육과 관련된 일을 맡아 하는 관청."]],"教育評価":[["きょういくひょうか","교육 평가 (敎育評價)","교육 목표에 비추어 학습자의 학습과 발달 정도를 측정하고 판단하는 일."]],"教育学":[["きょういくがく","교육학 (敎育學)","교육에 관한 이론을 연구하는 학문."]],"教徒":[["きょうと","교인 (敎人)","종교가 있는 사람."],["きょうと","교도 (敎徒)","어떤 종교를 믿는 사람. 또는 무리."],["きょうと","신자 (信者)"]],"教材":[["きょうざい","교재 (敎材)","교육이나 학습을 하는 데 필요한 교과서나 그 외의 자료."]],"教条":[["きょうじょう","교조 (敎條)","어떤 원리나 이론, 사상 등을 절대로 변하지 않는 진리처럼 여겨 덮어놓고 그대로 지키려 함."]],"教条的":[["きょうじょうてき","교조적 (敎條的)","어떤 원리나 이론, 사상 등을 절대로 변하지 않는 진리처럼 여겨 덮어놓고 그대로 지키려 하는 것."]],"教条主義":[["きょうじょうしゅぎ","교조주의 (敎條主義)","어떤 원리나 이론, 사상 등을 절대로 변하지 않는 진리처럼 여겨 덮어놓고 그대로 지키려는 태도."]],"教主":[["きょうしゅ","교주 (敎主)","한 종교 단체를 이끄는 사람. 또는 한 종교나 종파를 처음 세운 사람."]],"教旨":[["きょうし","교지 (敎旨)","(옛날에) 임금이 관리에게 내리던 명령."]],"教職":[["きょうしょく","교직 (敎職)","학생을 가르치는 직업."]],"教職員":[["きょうしょくいん","교직원 (敎職員)","학교의 교원과 사무직원."]],"教職者":[["きょうしょくしゃ","교직자 (敎職者)","학교에서 학생을 가르치는 직책을 맡은 사람."]],"教卓":[["きょうたく","교탁 (敎卓)","학교에서, 교사가 수업을 할 때에 책 등을 올려놓기 위하여 교단 위나 앞에 놓은 탁자."]],"鄙びる":[["ひなびる","궁벽하다 (窮僻하다)","도시에서 멀리 떨어진 구석에 있어 외지고 사람도 없어 조용하다."]],"紙巻タバコ":[["かみまきタバコ","궐련 (卷▽煙▽)","얇은 종이로 가늘고 길게 말아서 만든 담배."]],"教頭":[["きょうとう","교감 (校監)","학교에서 교장을 도와 학교 일을 관리하거나 지휘하는 직위, 또는 그러한 일을 하는 사람."]],"教科目":[["きょうかもく","교과목 (敎科目)","학교에서 학생들에게 가르치는 과목."]],"教科書":[["きょうかしょ","교과서 (敎科書)","학교에서 어떤 