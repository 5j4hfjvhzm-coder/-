{"干物":[["ひもの","건어물 (乾魚物)","생선이나 조개 등을 말린 것."]],"干し草":[["ほしくさ","건초 (乾草)","주로 짐승의 먹이나 거름으로 쓰는, 베어서 말린 풀."],["ほしくさ","깃"],["ほしくさ","마른풀"]],"干しブドウ":[["ほしブドウ","건포도 (乾葡萄)","물기를 말려서 작고 쪼글쪼글해진 포도."]],"捲る":[["めくる","젖히다","무엇을 뒤집거나 하여 안쪽이 겉으로 나오게 하다."],["めくる","떠들다","덮거나 가린 것을 한 부분만 걷어 젖히거나 쳐들다."],["めくる","들치다","한쪽 끝을 잡고 쳐들다."],["まくる","걷어붙이다","소매나 바지의 아랫부분 등을 위로 걷어 올리다."],["まくる","걷다","늘어지거나 펼쳐진 것을 위로 끌어 올리거나 말아 올리다."],["めくる","들추다","속이 드러나도록 들어 올리거나 헤집다."],["めくる","넘기다","종이나 책장 등을 젖히다."]],"捲られる":[["まくられる","걷히다","늘어지거나 가려져 있던 것이 치워지다."],["めくられる","넘어가다","종이나 책장 등이 넘겨지다."]],"掲げる":[["かかげる","달다","물건을 어떤 곳에 걸거나 꽂거나 매어서 붙어 있게 하다."],["かかげる","내걸다","밖이나 앞쪽에 걸다."],["かかげる","추켜들다","위로 향하게 들다."],["かかげる","걸다","이름이나 조건을 내세우다."],["かかげる","내세우다","어떤 사실을 공적으로 주장하거나 알리다."]],"黒っぽい":[["くろっぽい","거뭇하다","검은 빛이 조금 나다."],["くろっぽい","거무스레하다","검은 빛깔이 조금 나다."],["くろっぽい","거뭇거뭇하다","군데군데 검은 빛이 조금 나다."],["くろっぽい","거멓다"],["くろっぽい","감숭하다"],["くろっぽい","검숭하다"],["くろっぽい","가무끄름하다"]],"黒ずんでいる":[["くろずんでいる","거무죽죽하다","칙칙하고 고르지 않게 검은 빛이 조금 나다."],["くろずんでいる","가무댕댕하다","색이 고르지 않게 검다."],["くろずんでいる","가무칙칙하다","산뜻하지 않고 색이 짙고 검다."],["くろずんでいる","가무퇴퇴하다","색이 탁하고 검다."],["くろずんでいる","칙칙하다","빛깔이나 분위기 등이 산뜻하거나 맑지 않고 컴컴하고 어둡다."],["くろずんでいる","가무끄름하다"],["くろずんでいる","가무대대하다"],["くろずんでいる","가무스름하다"],["くろずんでいる","거무뎅뎅하다"]],"黒ずんで":[["くろずんで","거뭇거뭇","군데군데 검은 빛이 조금 나는 모양."],["くろずんで","가무스름히"]],"防護柵":[["ぼうごさく","가드레일 (guard-rail)","차가 찻길에서 벗어나는 것을 막기 위해 찻길의 양쪽 끝이나 중앙에 설치한 물건."]],"曲":[["きょく","곡 (曲)","작곡된 음악의 작품."],["きょく","가락","한국에서 전통적인 노래의 수를 세는 단위."],["きょく","-곡 (曲)","‘노래’ 또는 ‘악곡’의 뜻을 더하는 접미사."]],"曲調":[["きょくちょう","곡조 (曲調)","음악이나 노래의 흐름."],["きょくちょう","노랫가락","노래의 높고 낮고 길고 짧고 크고 작은 소리가 이어지는 것."],["きょくちょう","곡절 (曲節)","음악이나 노래에서 곡의 마디."],["きょくちょう","가락","음악에서 음의 높낮이의 흐름."]],"棒飴":[["ぼうあめ","가락엿","둥근 모양으로 길고 가늘게 만든 엿."]],"戒める":[["いましめる","타이르다","잘 알아듣도록 자상하고 조리 있게 말해 주다."],["いましめる","간언하다 (諫言하다)","웃어른이나 임금에게 잘못을 고치도록 말하다."],["いましめる","가르치다","잘못된 생각이나 습관 등을 바르게 고치다."]],"黒みがかっている":[["くろみがかっている","거무뎅뎅하다","고르지 않게 조금 검은 빛이 나다."],["くろみがかっている","감숭하다"],["くろみがかっている","검숭하다"],["くろみがかっている","가무레하다"],["