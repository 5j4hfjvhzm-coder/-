 오신 날","불교를 창시한 석가모니가 태어난 날. 음력으로 4월 8일이다."],["しゃかのたんじょうび","초파일 (初八▽日)","불교를 창시한 석가모니가 태어난 날. 음력으로 4월 8일이다."],["しゃかのたんじょうび","불생일 (佛生日)"],["しゃかのたんじょうび","불탄일 (佛誕日)"]],"惨状":[["さんじょう","참경 (慘景)","끔찍하고 비참한 광경."],["さんじょう","참상 (慘狀)","끔찍하고 비참한 모습이나 상황."]],"惨劇":[["さんげき","참극 (慘劇)","(비유적으로) 슬프고 끔찍한 일."]],"椈の木":[["ぶなのき","참나무","20~25미터 정도의 높이에 가장자리에 톱니가 있는 타원형 잎이 나며, 도토리가 열리고 목재는 가구의 재료로 쓰는 나무."]],"惨憺としている":[["さんたんとしている","참담하다 (慘澹/慘憺하다)","끔찍하고 절망적이다."]],"惨事":[["さんじ","참사 (慘事)","비참하고 끔찍한 일."],["さんじ","참변 (慘變)"]],"用意":[["ようい","마련","어떤 물건이나 상황을 준비하여 갖춤."],["ようい","준비 (準備)","미리 마련하여 갖춤."],["ようい","장만","필요한 것을 사거나 만들어서 가지거나 차림."],["ようい","채비","어떤 일을 위해 필요한 물건이나 자세 등이 미리 갖추어지거나 그렇게 되게 함. 또는 그 물건이나 자세."],["ようい","채비 (←差備)"]],"用意する":[["よういする","마련하다","어떤 물건이나 상황을 준비하여 갖추다."],["よういする","준비하다 (準備하다)","미리 마련하여 갖추다."],["よういする","장만하다","필요한 것을 사거나 만들어서 가지거나 차리다."],["よういする","채비하다","어떤 일을 위해 필요한 물건이나 자세 등이 미리 갖추어지다. 또는 어떤 일을 위해 필요한 물건이나 자세 등을 미리 갖추다."],["よういする","챙기다","빠뜨리거나 거르지 않다."],["よういする","보다","음식을 놓는 상이나 잠을 잘 자리 등을 준비하다."],["よういする","차리다","어떤 일을 하려고 준비를 하거나 방법을 찾다."]],"惨敗":[["ざんぱい","참패 (慘敗)","싸움이나 경기 등에서 매우 크게 지거나 실패함."],["ざんぱい","완패 (完敗)"]],"惨敗する":[["ざんぱいする","참패하다 (慘敗하다)","싸움이나 경기 등에서 매우 크게 지거나 실패하다."]],"惨酷":[["ざんこく","참혹 (慘酷)","매우 비참하고 끔찍함."],["ざんこく","잔혹 (殘酷)","인정이 없고 모질며 악함."],["ざんこく","잔악 (殘惡)","인정이 없고 아주 모질며 악독함."],["ざんこく","참혹하다 (慘酷하다)","매우 비참하고 끔찍하다."],["ざんこく","잔혹하다 (殘酷하다)","인정이 없고 모질며 악하다."]],"惨酷だ":[["ざんこくだ","참혹하다 (慘酷하다)","매우 비참하고 끔찍하다."],["ざんこくだ","잔혹하다 (殘酷하다)","인정이 없고 모질며 악하다."]],"惨禍":[["さんか","참화 (慘禍)","뜻밖에 일어난 비참하고 끔찍한 재앙이나 사고."]],"貨車":[["かしゃ","짐차 (짐車)","주로 화물을 실어 나르는 자동차."],["かしゃ","화차 (貨車)"]],"沈静する":[["ちんせいする","진정되다 (鎭靜되다)","시끄럽고 어지러운 분위기가 가라앉다."]],"守る":[["まもる","지키다","재산, 이익, 안전 등을 잃거나 외부로부터의 침범을 당하지 않게 보호하거나 감시하여 막다."],["まもる","달리다","경쟁에서 어떤 지위를 계속 유지하다."]],"守備する":[["しゅびする","수비하다 (守備하다)","외부의 침략이나 공격을 막아 지키다."],["しゅびする","지키다","재산, 이익, 안전 등을 잃거나 외부로부터의 침범을 당하지 않게 보호하거나 감시하여 막다."]],"用意される":[["よういされる","마련되다","어떤 물건이나 상황이 준비되어 갖추어지다."],["よういされる","준비되다 (準備되다)","미리 마련되어 갖추어지다."]],"用意させる":[["よういさせる","준비시키다 (準備시키다)","미리 마련하여 갖추게 하다."]],"済州島":[["チェジュド","제주도 (濟州道)","한국의 행정 구역 단위인 도의 하나. 한국의 가장 남쪽에 있으며 제주도를 비롯한 여러 섬으로 이루어져 있다."],["チェジュド","제주도 (濟州島)","한국 서남해에 있는 화산섬. 한국에서 가장 큰 섬으로 화산 활동 지형의 특색이 잘 드러나 있어 관광 산업이 발달하였다. 해녀, 말, 귤이 유명하다."]],"済州特別自治道":[["チェジュとくべつじちどう","제주특별자치도 (濟州特別自治道)","한국 남서부에 있는 섬으로 된 특별자치도. 남한에서 가장 큰 섬인 제주도와 55개의 무인도를 포함하여 총 63개 섬으로 이루어져 있다. 한국의 행정 구역 중 인구가 가장 적다. 자연환경이 아름다운 국제 관광지이다."]],"扨措く":[["さておく","접어놓다","빼거나 미뤄 놓고 관심을 두지 않다."],["さておく","제치다","일정한 대상이나 범위에서 빼다."]],"扨置く":[["さておく","접어놓다","빼거나 미뤄 놓고 관심을 두지 않다."],["さておく","제치다","일정한 대상이나 범위에서 빼다."]],"旨い":[["うまい","좋다","어떤 것의 성질이나 내용 등이 훌륭하여 만족할 만하다."],["うまい","맛나다","맛이 좋다."],["うまい","맛있다","맛이 좋다."]],"用心":[["ようじん","조심 (操心)","좋지 않은 일을 겪지 않도록 말이나 행동 등에 주의를 함."]],"用心深い":[["ようじんぶかい","조심스럽다 (操心스럽다)","잘못이나 실수를 하지 않도록 말이나 행동 등에 주의를 하는 태도가 있다."],["ようじんぶかい","신중하다 (愼重하다)","매우 조심스럽다."],["ようじんぶかい","꼼꼼하다"],["ようじんぶかい","조심스럽다 (操心-)"]],"用心深く":[["ようじんぶかく","조심히 (操心히)","좋지 않은 일을 겪지 않도록 말이나 행동 등에 주의를 하며."],["ようじんぶかく","조심스레 (操心스레)","잘못이나 실수를 하지 않도록 말이나 행동 등에 주의를 하는 태도로."],["ようじんぶかく","조심조심 (操心操心)","잘못이나 실수를 하지 않도록 말이나 행동 등에 매우 주의를 하는 모양."],["ようじんぶかく","신중히 (愼重히)","매우 조심스럽게."],["ようじんぶかく","꼼꼼히"]],"旨く":[["うまく","제대로","마음먹은 대로."]],"全人教育":[["ぜんじんきょういく","전인 교육 (全人敎育)","지식이나 기술 등의 교육에만 치우치지 않고 인간이 지닌 모든 소질과 성품을 조화롭게 발달시키는 것을 목적으로 하는 교육."]],"全日":[["ぜんじつ","전일 (全日)","하루 종일."]],"全作品":[["ぜんさくひん","전작 (全作)","한 작가의 모든 작품이나 일정한 분야의 모든 작품."]],"全的":[["ぜんてき","전적 (全的)","하나도 빠짐없이 모두 다인 것."]],"全州":[["チョンジュ","전주 (全州)","한국의 전라북도 중앙부에 있는 시. 전라북도의 도청 소재지이며, 창호지, 장판지의 생산과 전주비빔밥 등으로 유명하다."]],"全知全能":[["ぜんちぜんのう","전지전능 (全知全能)","모든 일을 잘 알고, 모든 일을 할 수 있음. 또는 그런 능력."],["ぜんちぜんのう","전지전능하다 (全知全能하다)","모든 일을 잘 알고, 모든 일을 할 수 있다."]],"全知全能だ":[["ぜんちぜんのうだ","전지전능하다 (全知全能하다)","모든 일을 잘 알고, 모든 일을 할 수 있다."]],"全集":[["ぜんしゅう","전집 (全集)","한 사람의 모든 작품이나 같은 시대나 같은 종류의 작품을 한데 모아 출판한 책."],["ぜんしゅう","전질 (全帙)"]],"全天候":[["ぜんてんこう","전천후 (全天候)","어떠한 날씨에도 제 기능을 다할 수 있음."]],"全体":[["ぜんたい","전체 (全體)","낱낱이나 부분의 집합으로 이루어진 것을 하나의 대상으로 할 때 바로 그 대상."],["ぜんたい","전반 (全般)"],["ぜんたい","총체 (總體)"]],"全体的":[["ぜん