:[["すべての","온","전부의. 또는 모두의."]],"全世界":[["ぜんせかい","온누리","사람이 사는 세상이나 사회 전부."],["ぜんせかい","두남 (斗南)"],["ぜんせかい","우내 (宇內)"],["ぜんせかい","전세계 (全世界)"]],"鴨緑江":[["アムノッカン","압록강 (鴨綠江)","백두산에서 시작하여 서해로 흘러드는 강. 한반도에서 가장 긴 강으로 북한과 중국의 국경을 이룬다. 수풍 발전소가 유명하다."]],"用いられる":[["もちいられる","쓰이다","어떤 일을 하는 데에 재료나 도구, 수단 등이 이용되다."],["もちいられる","사용되다 (使用되다)","무엇이 필요한 일이나 기능에 맞게 쓰이다."]],"沈清":[["シムチョン","심청 (沈淸)","‘심청전’의 여자 주인공. 효심이 깊은 딸로 장님인 아버지의 눈을 뜨게 하기 위해 제물로 팔려갔지만 용왕의 도움으로 세상에 나왔다가 왕후가 된다."]],"沈清歌":[["シムチョンガ","심청가 (沈淸歌)","판소리 다섯 마당의 하나. 효녀 심청이 장님인 아버지의 눈을 뜨게 하기 위하여 제물로 팔려갔지만 용왕의 도움으로 세상에 나왔다가 왕후가 된다는 ‘심청전’의 내용을 담고 있다."]],"沈清伝":[["シムチョンジョン","심청전 (沈淸傳)","조선 후기의 소설. 지은이와 지어진 시기는 알 수 없다. 효녀 심청이 장님인 아버지의 눈을 뜨게 하기 위하여 제물로 팔려갔지만 용왕의 도움으로 세상에 나왔다가 왕후가 된다는 이야기이다."]],"用いる":[["もちいる","쓰다","어떤 일을 하는 데에 재료나 도구, 수단 등을 이용하다."],["もちいる","사용하다 (使用하다)","무엇을 필요한 일이나 기능에 맞게 쓰다."]],"守旧":[["しゅきゅう","수구 (守舊)","옛 제도나 풍습을 그대로 지키고 따름."]],"守旧派":[["しゅきゅうは","수구파 (守舊派)","옛 제도나 풍습을 그대로 지키고 따르려는 무리."]],"守旧する":[["しゅきゅうする","수구하다 (守舊하다)","옛 제도나 풍습을 그대로 지키고 따르다."]],"沈静化する":[["ちんせいかする","수그러들다","힘이나 기세가 점점 줄어들다."],["ちんせいかする","수그러지다","힘이나 기세가 점점 약해지다."]],"守銭奴":[["しゅせんど","수전노 (守錢奴)","(낮잡아 이르는 말로) 돈을 몹시 아껴 모으기만 하고 쓰지는 않는 사람."]],"守節":[["しゅせつ","수절 (守節)","남편이 죽고 나서 다시 결혼하지 않고 혼자 지냄."]],"守衛":[["しゅえい","수위 (守衛)","회사, 학교, 아파트 등에서 사고가 일어나지 않게 살피고 지키는 사람."]],"守衛室":[["しゅえいしつ","수위실 (守衛室)","정문이나 현관 옆에 있어, 수위가 머물며 드나드는 사람을 살피고 경비하는 방."]],"守則":[["しゅそく","수칙 (守則)","지키도록 정한 규칙."]],"守護":[["しゅご","수호 (守護)","지키고 보호함."]],"守護される":[["しゅごされる","수호되다 (守護되다)","지켜지고 보호되다."]],"守護神":[["しゅごしん","수호신 (守護神)","국가나 민족, 개인 등을 지키고 보호하는 신."]],"守り神":[["まもりがみ","수호신 (守護神)","국가나 민족, 개인 등을 지키고 보호하는 신."]],"守護者":[["しゅごしゃ","수호자 (守護者)","지키고 보호하는 사람."]],"守護する":[["しゅごする","수호하다 (守護하다)","지키고 보호하다."]],"守備":[["しゅび","수비 (守備)","외부의 침략이나 공격을 막아 지킴."],["しゅび","디펜스 (defence)"]],"守備力":[["しゅびりょく","수비력 (守備力)","운동 경기에서 상대편의 공격을 막아 내는 힘."]],"守備網":[["しゅびもう","수비망 (守備網)","주로 운동 경기에서 상대편의 공격을 막기 위해 그물처럼 펼쳐 놓은 조직."]],"守備壁":[["しゅびへき","수비벽 (守備壁)","운동 경기에서, 상대편의 공격을 막는 조직."]],"守備陣":[["しゅびじん","수비진 (守備陣)","외부의 공격을 막기 